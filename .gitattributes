# Normalize line endings.
* text=auto eol=lf

# Godot text resources.
*.gd text eol=lf
*.godot text eol=lf
*.tscn text eol=lf
*.tres text eol=lf
*.res -text
*.import text eol=lf
*.shader text eol=lf
*.json text eol=lf
*.csv text eol=lf
*.md text eol=lf
*.txt text eol=lf

