[gd_resource type="Resource" script_class="LocalizedTextCatalog" load_steps=2 format=3]
[ext_resource type="Script" path="res://scripts/data_types/localized_text_catalog.gd" id="1"]
[resource]
script = ExtResource("1")
localized_text = {
"ko-KR": {
"P3_NAME_BOOK_MECHANICAL": "기계 도면집",
"P3_NAME_BOOK_FLORA": "온실 식물지",
"P3_NAME_BOOK_LEDGER": "식탁 업무록",
"P3_SHELF_CLOCK": "시계·수직선\n기계공학",
"P3_SHELF_FLOWER": "꽃잎·후광\n식물·환경",
"P3_SHELF_CUP": "찻잔·이중고리\n생활 기록",
"P3_PLACED": "{book}\n[정리됨]",
"P3_INNER_DOOR": "기록 내실 유리문\n잠김",
"P3_Q_AUTHOR": "누가 쓴 장부입니까?",
"P3_Q_LOCKED": "왜 잠겨 있습니까?",
"P3_Q_SILENT": "말없이 내려놓는다",
"P3_A_AUTHOR": "주인님의 기록입니다.",
"P3_A_LOCKED": "손상된 기록은 잘못 읽히기 쉽습니다.",
"P3_SILENT_STATUS": "말없이 장부를 내려놓았다. 에드가는 잠금쇠가 닫힌 것을 확인한다.",
"P3_INTRO": "외부 서고의 반납분입니다. 책등 문양과 선반 표식을 맞춰 주십시오.",
"P3_RESTRICTED": "기록 내실은 정리 대상이 아닙니다.",
"P3_SELECT": "오른쪽 인벤토리의 책을 선반으로 드래그하십시오.",
"P3_WRONG": "책은 들어가지만 책등 높이가 맞지 않는다. 문양과 선반 표식을 다시 비교한다.",
"P3_DISCOVER": "반납 슬롯 안쪽에서 낡은 일지 한 권이 떨어진다. 표지는 읽히지 않고, 본문 잉크는 한 방향으로 밀린 것처럼 겹쳐 있다.",
"P3_LEDGER": "오래된 연구 장부입니다. 현재는 열람 대상이 아닙니다. 제자리에 두시는 편이 좋겠습니다.",
"P3_HEADER": "장부에 대해 묻는다",
"P3_PROMPT": "에드가는 장부를 내려놓으라는 듯 손을 내민다. 무엇을 물어볼까.",
"P3_RESUME": "내려놓지 못한 낡은 장부가 아직 손안에 있다. 표지의 글자는 읽히지 않는다.",
"P3_COMPLETE": "분류가 끝났습니다. 기록 내실은 그대로 두십시오.",
"P3_DOOR": "손잡이보다 안쪽 걸쇠가 먼저 버틴다. 문틀에는 열쇠구멍 대신 레이피어 날처럼 가는 세로 홈이 있다.",
"UI_INV_EMPTY": "비어 있음",
"UI_INV_EMPTY_DESC": "빈 인벤토리 칸",
"UI_INV_DRAG_HINT": "대상으로 드래그하여 사용",
"UI_INV_DESC": "{item}. 대상 위로 드래그하거나 선택 후 대상을 누르십시오.",
"UI_INV_SELECTED": "선택: {item} · 대상 위로 드래그하거나 대상을 누르십시오.",
"UI_INV_DRAGGING": "드래그 중: {item}",
"UI_INV_DRY_HINT": "마른 면으로 아래 물기를 제거",
"P2_TOOL_CLOTH": "부드러운 천",
"P2_TOOL_BRUSH": "거친 솔",
"P2_TOOL_WATER": "물병",
"P2_TOOL_SPANNER": "마라 1의 스패너",
"P2_TOOL_INTRO": "오셨슴까, 아가씨. 전 위쪽을 맡을 테니 아래쪽 세 장만 부탁드림다.",
"P2_TOOL_GUIDE": "부드러운 천을 고르고 위의 먼지부터 아래로. 스패너는 쓰지 마십쇼. 저도 방금 쓸 뻔했으니까.",
"P2_TOOL_ALREADY": "이미 깨끗한 창이다.",
"P2_TOOL_SPANNER_FEEDBACK": "스패너는 창문에 사용할 수 없다. 마라 1이 황급히 손을 내민다.",
"P2_TOOL_SPANNER_LINE": "그걸로 닦으면 창문보다 벽부터 열릴 검다. 천을 쓰십쇼, 천.",
"P2_TOOL_BRUSH_FEEDBACK": "거친 솔이 먼지를 양옆으로 퍼뜨렸다. 부드러운 천으로 바로 복구할 수 있다.",
"P2_TOOL_BRUSH_LINE": "아가씨, 그 솔 말고 부드러운 천 말임다! 퍼진 먼지는 위에서부터 다시 모으면 됨다.",
"P2_TOOL_WATER_STAIN": "물로 얼룩이 풀렸다. 아래에 흐른 물기를 부드러운 천의 마른 면으로 걷어내야 한다.",
"P2_TOOL_WATER_BOTTOM": "깨끗한 아래쪽이 다시 젖었다. 부드러운 천의 마른 면이 필요하다.",
"P2_TOOL_WATER_WRONG": "먼지가 남은 상태에서 물을 쓰면 얼룩만 번진다. 위쪽 먼지부터 정리해야 한다.",
"P2_TOOL_TOP_CLEAN": "위쪽 먼지를 아래 방향으로 모아 걷어냈다.",
"P2_TOOL_BIRD": "같은 새가 같은 날갯짓으로 다시 창을 가로지른다.",
"P2_TOOL_BIRD_LINE": "일은 천천히 하시는데 눈은 좋으심다. 저 새까지 닦아낼 생각은 하지 마십쇼. ...농담입니다. 아마도.",
"P2_TOOL_MIDDLE_ORDER": "아래부터 닦자 위쪽 먼지가 다시 떨어졌다. 위에서 아래 순서로 진행해야 한다.",
"P2_TOOL_MIDDLE_CLEAN": "가운데 얼룩을 원형으로 닦아냈다.",
"P2_TOOL_MIDDLE_ALREADY": "가운데는 이미 깨끗하다.",
"P2_TOOL_BOTTOM_ORDER": "아래부터 닦자 위쪽 오염이 다시 떨어졌다. 위에서 아래 순서로 진행해야 한다.",
"P2_TOOL_BOTTOM_CLEAN": "부드러운 천의 마른 면으로 아래 물기를 걷어냈다.",
"P2_TOOL_BOTTOM_ALREADY": "아래쪽은 이미 마른 상태다.",
"P2_TOOL_INVALID": "이 물건은 창문 닦기에 사용할 수 없다.",
"P2_TOOL_COMPLETE_LINE": "깔끔함다! 다음에도 이 정도면 제가 일손 부족 얘기는 반만 하겠슴다.",
"P2_DRAG": "도구를 원하는 오염 영역으로 드래그하십시오.",
"P2_INSPECTING": "창 {index} 확대 조사 중",
"P2_CLOSED": "창문 확대를 닫았다. 다른 창을 선택할 수 있다.",
"P2_TITLE": "창 {index} 확대 · {state}",
"P2_TOP": "위쪽\n{state}",
"P2_MIDDLE": "가운데\n{state}",
"P2_BOTTOM": "아래\n{state}",
"P2_SPREAD": "먼지가 양옆으로 퍼짐",
"P2_DUST": "먼지",
"P2_CLEAR": "정리됨",
"P2_STAIN": "얼룩",
"P2_WET": "물기",
"P2_DRY": "마른 상태",
"P2_CLEAN_HINT": "완료된 창입니다. 오염 패턴을 다시 확인할 수 있습니다.",
"P2_ACTIVE_HINT": "오른쪽 인벤토리의 도구를 위·가운데·아래 영역으로 드래그하십시오.",
"P2_SELECT_HINT": "먼저 인벤토리에서 도구를 드래그하십시오. 키보드 조작은 도구 선택 후 영역을 누릅니다.",
"P2_STAGE_TOP": "위쪽 먼지",
"P2_STAGE_MIDDLE": "가운데 얼룩",
"P2_STAGE_BOTTOM": "아래쪽 물기",
"NOTE_P_DUTIES": "오늘의 일과: 대응접실 창문, 외부 서고 책, 북쪽 회랑 초상화.",
"NOTE_P_IMPRESSIONS": "수첩의 빈 페이지 아래에 이전 필압 같은 자국이 남아 있다.",
"NOTE_P_BIRD": "같은 새가 18초 간격으로 같은 궤도를 두 번 지나갔다.",
"NOTE_P_WINDOWS": "대응접실의 세 창을 닦았다. 주황빛 닦임 자국이 천보다 한순간 먼저 움직였다.",
"NOTE_P_JOURNAL": "기계 도면집 뒤에서 낡은 연구 장부가 떨어졌다. 안쪽 면에는 내가 그린 듯한 고딕 저택 낙서가 있다.",
"NOTE_P_SIGNATURES": "다섯 사용인의 데이터 서명: LOCK, MAINT, BIO, CLIMATE, ARCHIVE. 색이 없어도 문양과 소리로 구별할 수 있다.",
"NOTE_P_PULSE": "주방의 규칙적인 진동",
"NOTE_P_WEATHER": "복도와 온실의 날씨가 동시에 다르다. 소리는 나지만 문턱은 젖지 않는다.",
"NOTE_P_SLEEP": "오늘을 끝내고 잠든다.",
"NOTE_P_TEA": "찻잔 손잡이가 왼쪽 자리를 향했다. 낯익은 향과 더 큰 손의 잔상. 얼굴과 대사는 떠오르지 않는다.",
"UI_NOTE_TITLE": "주인공의 수첩",
"UI_NOTE_EMPTY": "아직 기록이 없다.",
"UI_NOTE_CLOSE": "닫기",
"UI_NOTE_PERMANENT": "수첩 · 영구 기록",
"UI_NOTE_PERSIST": "잠들어도 확인한 기록은 남는다.",
"UI_NOTE_COMPARE_EMPTY": "아직 비교를 마친 기록이 없다.",
"UI_DUTY_PARLOR": "대응접실 · 창문",
"UI_DUTY_LIBRARY": "외부 서고 · 책",
"UI_DUTY_ARCHIVE": "북쪽 회랑 · 초상화",
"UI_DUTY_KITCHEN": "주방 · 차 준비",
"UI_DUTY_REPORT": "에드가에게 보고",
"UI_DUTY_PENDING": "미완료",
"UI_DUTY_COMPLETE": "완료",
"UI_DUTY_REMAINING": "아직 남은 일과가 있습니다. {tasks}. 순서는 자유지만 확인 없이 넘길 수는 없습니다.",
"UI_OBJECTIVE_P1": "침실을 살펴보고 아침 일과를 시작한다",
"UI_OBJECTIVE_MORNING": "아침 일과 {count} / 3 · 순서는 자유",
"UI_OBJECTIVE_TEA_MEMORY": "찻잔의 기억을 확인하고 루카에게 한 가지 묻는다",
"UI_OBJECTIVE_TEA": "주방에서 차를 준비한다",
"UI_OBJECTIVE_EVENING": "저녁 자유 조사 · 온실은 선택 · 침실에서 하루 종료",
"P1_LABEL_BED": "침대",
"P1_LABEL_WINDOW": "침실 창문",
"P1_LABEL_PHOTO": "아버지 사진",
"P1_LABEL_NOTEBOOK": "낙서 수첩",
"P1_LABEL_EXIT": "방을 나선다",
"P1_INSPECT_BED": "막 일어난 자리인데도 주름 하나 없이 반듯하다. 천 아래에는 매트리스보다 단단한 곡면이 닿는다.",
"P1_INSPECT_WINDOW": "정원은 맑다. 그런데 유리는 햇빛보다 미지근하고, 멀리 있는 새는 한 번도 고도를 바꾸지 않는다.",
"P1_INSPECT_PHOTO": "아버지와 함께 찍힌 사진이다. 익숙한 얼굴인데 이 장면으로 이어지는 기억은 없다. 사진 표면만 차갑다.",
"P1_INSPECT_NOTEBOOK": "고딕 저택 낙서와 빈 페이지. 연필 압흔은 내가 쓰기 전부터 다음 장까지 이어져 있다.",
"P1_EXIT_TITLE": "에드가의 확인",
"P1_EXIT_CONFIRM": "아직 방 안을 충분히 살펴보지 않았습니다. 그래도 일과를 시작합니까?",
"P1_EXIT_START": "일과를 시작한다",
"P1_EXIT_STAY": "조금 더 살펴본다",
"P1_HALL_VIEW": "계단 아래에서 저택의 세 방향이 한눈에 들어온다.",
"P1_HALL_EDGAR": "순서는 정하지 않겠습니다. 완료한 일은 중앙홀에서 확인할 수 있습니다.",
"UI_DIALOGUE_CONTINUE": "계속",
