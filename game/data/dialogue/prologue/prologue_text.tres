[gd_resource type="Resource" script_class="LocalizedTextCatalog" load_steps=2 format=3]
[ext_resource type="Script" path="res://scripts/data_types/localized_text_catalog.gd" id="1"]
[resource]
script = ExtResource("1")
localized_text = {
"ko-KR": {
"P1_WAKE_LIGHT": "커튼 사이의 아침빛이 눈꺼풀보다 먼저 같은 자리를 밝힌다.",
"P1_WAKE_KNOCK": "[문밖] 레이피어 끝이 바닥에 닿고, 정확히 세 번의 노크가 이어진다.",
"P1_WAKE_EDGAR": "기상 시각입니다, 아가씨. 오늘 일정은 준비되어 있습니다.",
"P1_WAKE_TASKS": "방 안을 확인하신 뒤 나와 주십시오. 대응접실의 창문, 외부 서고의 책, 북쪽 기록 회랑의 초상화를 부탁드립니다.",
"P1_WAKE_OBJECTIVE": "빛과 사물 중 마음에 걸리는 것을 조사해 보십시오."
},
"en-US": {
"P1_WAKE_LIGHT": "Morning light slips through the curtains, finding the same spot before your eyelids open.",
"P1_WAKE_KNOCK": "[Outside the door] The tip of a rapier touches the floor. Exactly three knocks follow.",
"P1_WAKE_EDGAR": "It is time to rise, my lady. Your schedule for today is ready.",
"P1_WAKE_TASKS": "Please come out after inspecting your room. The parlor windows, the books in the outer library, and the portraits in the northern archive corridor require your attention.",
"P1_WAKE_OBJECTIVE": "Examine the light and any objects that catch your attention."
}
}
