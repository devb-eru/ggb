[gd_resource type="Resource" script_class="LocalizedTextCatalog" load_steps=2 format=3]
[ext_resource type="Script" path="res://scripts/data_types/localized_text_catalog.gd" id="1"]
[resource]
script = ExtResource("1")
localized_text = {
"ko-KR": {
"NOTE_P_DUTIES": "오늘의 일과: 대응접실 창문, 외부 서고 책, 북쪽 회랑 초상화.",
"NOTE_P_IMPRESSIONS": "수첩의 빈 페이지 아래에 이전 필압 같은 자국이 남아 있다.",
"NOTE_P_BIRD": "같은 새가 18초 간격으로 같은 궤도를 두 번 지나갔다.",
"NOTE_P_WINDOWS": "대응접실의 세 창을 닦았다. 주황빛 닦임 자국이 천보다 한순간 먼저 움직였다.",
"NOTE_P_JOURNAL": "기계 도면집 뒤에서 낡은 연구 장부가 떨어졌다. 안쪽 면에는 내가 그린 듯한 고딕 저택 낙서가 있다.",
"NOTE_P_SIGNATURES": "다섯 사용인의 데이터 서명: LOCK, MAINT, BIO, CLIMATE, ARCHIVE. 색이 없어도 문양과 소리로 구별할 수 있다.",
"NOTE_P_PULSE": "주방의 규칙적인 진동",
"NOTE_P_WEATHER": "복도와 온실의 날씨가 동시에 다르다. 소리는 나지만 문턱은 젖지 않는다.",
"NOTE_P_SLEEP": "오늘을 끝내고 잠든다.",
"NOTE_P_TEA": "찻잔 손잡이가 왼쪽 자리를 향했다. 낯익은 향과 더 큰 손의 잔상. 얼굴과 대사는 떠오르지 않는다.",
"UI_NOTE_TITLE": "주인공의 수첩",
"UI_NOTE_EMPTY": "아직 기록이 없다.",
"UI_NOTE_CLOSE": "닫기",
"UI_NOTE_PERMANENT": "수첩 · 영구 기록",
"UI_NOTE_PERSIST": "잠들어도 확인한 기록은 남는다.",
"UI_NOTE_COMPARE_EMPTY": "아직 비교를 마친 기록이 없다.",
"UI_DUTY_PARLOR": "대응접실 · 창문",
"UI_DUTY_LIBRARY": "외부 서고 · 책",
"UI_DUTY_ARCHIVE": "북쪽 회랑 · 초상화",
"UI_DUTY_KITCHEN": "주방 · 차 준비",
"UI_DUTY_REPORT": "에드가에게 보고",
"UI_DUTY_PENDING": "미완료",
"UI_DUTY_COMPLETE": "완료",
"UI_DUTY_REMAINING": "아직 남은 일과가 있습니다. {tasks}. 순서는 자유지만 확인 없이 넘길 수는 없습니다.",
"UI_OBJECTIVE_P1": "침실을 살펴보고 아침 일과를 시작한다",
"UI_OBJECTIVE_MORNING": "아침 일과 {count} / 3 · 순서는 자유",
"UI_OBJECTIVE_TEA_MEMORY": "찻잔의 기억을 확인하고 루카에게 한 가지 묻는다",
"UI_OBJECTIVE_TEA": "주방에서 차를 준비한다",
"UI_OBJECTIVE_EVENING": "저녁 자유 조사 · 온실은 선택 · 침실에서 하루 종료",
"P1_LABEL_BED": "침대",
"P1_LABEL_WINDOW": "침실 창문",
"P1_LABEL_PHOTO": "아버지 사진",
"P1_LABEL_NOTEBOOK": "낙서 수첩",
"P1_LABEL_EXIT": "방을 나선다",
"P1_INSPECT_BED": "막 일어난 자리인데도 주름 하나 없이 반듯하다. 천 아래에는 매트리스보다 단단한 곡면이 닿는다.",
"P1_INSPECT_WINDOW": "정원은 맑다. 그런데 유리는 햇빛보다 미지근하고, 멀리 있는 새는 한 번도 고도를 바꾸지 않는다.",
"P1_INSPECT_PHOTO": "아버지와 함께 찍힌 사진이다. 익숙한 얼굴인데 이 장면으로 이어지는 기억은 없다. 사진 표면만 차갑다.",
"P1_INSPECT_NOTEBOOK": "고딕 저택 낙서와 빈 페이지. 연필 압흔은 내가 쓰기 전부터 다음 장까지 이어져 있다.",
"P1_EXIT_TITLE": "에드가의 확인",
"P1_EXIT_CONFIRM": "아직 방 안을 충분히 살펴보지 않았습니다. 그래도 일과를 시작합니까?",
"P1_EXIT_START": "일과를 시작한다",
"P1_EXIT_STAY": "조금 더 살펴본다",
"P1_HALL_VIEW": "계단 아래에서 저택의 세 방향이 한눈에 들어온다.",
"P1_HALL_EDGAR": "순서는 정하지 않겠습니다. 완료한 일은 중앙홀에서 확인할 수 있습니다.",
"UI_DIALOGUE_CONTINUE": "계속",
"UI_DIALOGUE_FINISH": "마침",
"UI_SPEAKER_SYSTEM": "SYSTEM",
"UI_SPEAKER_SUBJECT": "주인공",
"UI_SPEAKER_EDGAR": "에드가",
"UI_SPEAKER_MARA1": "마라 1",
"UI_SPEAKER_MARA2": "마라 2",
"UI_SPEAKER_LUKA": "루카",
"UI_SPEAKER_IRIS": "이리스",
"P1_WAKE_LIGHT": "커튼 사이의 아침빛이 눈꺼풀보다 먼저 같은 자리를 밝힌다.",
"P1_WAKE_KNOCK": "[문밖] 레이피어 끝이 바닥에 닿고, 정확히 세 번의 노크가 이어진다.",
"P1_WAKE_EDGAR": "기상 시각입니다, 아가씨. 오늘 일정은 준비되어 있습니다.",
"P1_WAKE_TASKS": "방 안을 확인하신 뒤 나와 주십시오. 대응접실의 창문, 외부 서고의 책, 북쪽 기록 회랑의 초상화를 부탁드립니다.",
"P1_WAKE_OBJECTIVE": "빛과 사물 중 마음에 걸리는 것을 조사해 보십시오."
},
"en-US": {
"NOTE_P_DUTIES": "Today's duties: the parlor windows, the outer library books, and the north corridor portraits.",
"NOTE_P_IMPRESSIONS": "Marks like old pencil impressions remain beneath the notebook's blank pages.",
"NOTE_P_BIRD": "The same bird followed the same path twice, eighteen seconds apart.",
"NOTE_P_WINDOWS": "I cleaned the parlor's three windows. An orange wiping trace moved a moment before the cloth.",
"NOTE_P_JOURNAL": "An old research ledger fell from behind the mechanical drawings. Inside is a sketch of a Gothic mansion that looks like my own work.",
"NOTE_P_SIGNATURES": "The five servants' data signatures: LOCK, MAINT, BIO, CLIMATE, ARCHIVE. Patterns and sounds distinguish them even without color.",
"NOTE_P_PULSE": "The kitchen's rhythmic vibration",
"NOTE_P_WEATHER": "The corridor and greenhouse have different weather at the same time. I can hear it, but the threshold stays dry.",
"NOTE_P_SLEEP": "I end the day and go to sleep.",
"NOTE_P_TEA": "The cup's handle pointed toward the seat on the left. A familiar scent and the afterimage of a larger hand. No face or words come to mind.",
"UI_NOTE_TITLE": "Protagonist's notebook",
"UI_NOTE_EMPTY": "No entries yet.",
"UI_NOTE_CLOSE": "Close",
"UI_NOTE_PERMANENT": "Notebook · permanent records",
"UI_NOTE_PERSIST": "Records you have confirmed remain after sleep.",
"UI_NOTE_COMPARE_EMPTY": "No records have been compared yet.",
"UI_DUTY_PARLOR": "Parlor · windows",
"UI_DUTY_LIBRARY": "Outer library · books",
"UI_DUTY_ARCHIVE": "North corridor · portraits",
"UI_DUTY_KITCHEN": "Kitchen · prepare tea",
"UI_DUTY_REPORT": "Report to Edgar",
"UI_DUTY_PENDING": "Pending",
"UI_DUTY_COMPLETE": "Complete",
"UI_DUTY_REMAINING": "There are duties remaining: {tasks}. You may choose the order, but I must confirm their completion.",
"UI_OBJECTIVE_P1": "Inspect the bedroom and begin the day's duties",
"UI_OBJECTIVE_MORNING": "Morning duties {count} / 3 · choose any order",
"UI_OBJECTIVE_TEA_MEMORY": "Explore the cup's memory and ask Luka one question",
"UI_OBJECTIVE_TEA": "Prepare tea in the kitchen",
"UI_OBJECTIVE_EVENING": "Free evening · greenhouse optional · end the day in the bedroom",
"P1_LABEL_BED": "Bed",
"P1_LABEL_WINDOW": "Bedroom window",
"P1_LABEL_PHOTO": "Father's photograph",
"P1_LABEL_NOTEBOOK": "Sketch notebook",
"P1_LABEL_EXIT": "Leave the room",
"P1_INSPECT_BED": "I just got up, yet not a wrinkle remains. Beneath the fabric, I feel a curved surface harder than a mattress.",
"P1_INSPECT_WINDOW": "The garden is bright. Yet the glass feels oddly lukewarm in the sunlight, and the distant bird never changes altitude.",
"P1_INSPECT_PHOTO": "A photograph of Father and me. His face is familiar, but I cannot remember being here with him. Only the surface of the photograph feels cold.",
"P1_INSPECT_NOTEBOOK": "Sketches of a Gothic mansion, then blank pages. Before I even write, pencil impressions already reach into the next sheet.",
"P1_EXIT_TITLE": "Edgar's inquiry",
"P1_EXIT_CONFIRM": "You have not finished inspecting your room. Shall you begin your duties nonetheless?",
"P1_EXIT_START": "Begin the day's duties",
"P1_EXIT_STAY": "Look around a little longer",
"P1_HALL_VIEW": "From the foot of the stairs, three routes through the mansion come into view.",
"P1_HALL_EDGAR": "I will leave the order to you. You can review completed duties in the central hall.",
"UI_DIALOGUE_CONTINUE": "Continue",
"UI_DIALOGUE_FINISH": "Finish",
"UI_SPEAKER_SYSTEM": "SYSTEM",
"UI_SPEAKER_SUBJECT": "Protagonist",
"UI_SPEAKER_EDGAR": "Edgar",
"UI_SPEAKER_MARA1": "Mara 1",
"UI_SPEAKER_MARA2": "Mara 2",
"UI_SPEAKER_LUKA": "Luka",
"UI_SPEAKER_IRIS": "Iris",
"P1_WAKE_LIGHT": "Morning light slips through the curtains, finding the same spot before your eyelids open.",
"P1_WAKE_KNOCK": "[Outside the door] The tip of a rapier touches the floor. Exactly three knocks follow.",
"P1_WAKE_EDGAR": "It is time to rise, my lady. Your schedule for today is ready.",
"P1_WAKE_TASKS": "Please come out after inspecting your room. The parlor windows, the books in the outer library, and the portraits in the northern archive corridor require your attention.",
"P1_WAKE_OBJECTIVE": "Examine the light and any objects that catch your attention."
}
}
