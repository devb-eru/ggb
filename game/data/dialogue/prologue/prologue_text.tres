"en-US": {
"PF_GREENHOUSE": "Greenhouse entrance · optional investigation",
"PF_BEDROOM": "Return to the bedroom",
"PF_PARLOR": "The quiet parlor",
"PF_LIBRARY": "Toward the locked library",
"PF_LIGHT": "The parlor windows still bear the traces of this morning's cleaning, but the light outside has not shifted at all.",
"PF_PAGES": "Pages rustle behind the inner archive's glass door. No one is visible inside.",
"UI_P_AUTOSAVE": "Progress is saved automatically when you complete duties or move between rooms.",
"UI_P_RETURN_TITLE": "Return to title",
