[gd_resource type="Resource" script_class="LocalizedTextCatalog" load_steps=2 format=3]
[ext_resource type="Script" path="res://scripts/data_types/localized_text_catalog.gd" id="1"]
[resource]
script = ExtResource("1")
localized_text = {
"ko-KR": {
"CH1_BSHORT_BEDROOM": "같은 침실에서 수첩을 펼치고 준비 동선을 시작한다.",
"CH1_BSHORT_UNAVAILABLE": "리셋 뒤 검증한 배치와 아직 해결되지 않은 실패 기록이 필요하다. 이미 신호를 만들었거나 파형을 기록했다면 그 결과를 이어서 조사한다.",
"CH1_BSHORT_COMPLETE": "같은 침실에서 일과를 마쳤다. 기록해 둔 순서로 네 방의 탁본을 새로 뜨고, 검증한 배선과 역할만 다시 놓는다. 전달 시점은 직접 정한다.",
"CH1_B4_NEED_SIGNAL": "공명통에 신호가 남아 있어야 파형을 기록할 수 있다.",
"CH1_B4_RECORD": "공명통의 세 파형을 투명지에 기록",
"CH1_B4_RECORDED": "길고 낮은 진입파, 짧게 갈라지는 두 반사파, 바깥을 닫는 느린 잔류파를 투명지에 기록했다.",
"CH1_J2_ALREADY": "두 번째 페이지는 이미 복원되어 있다. 수첩에서 다시 읽는다.",
"CH1_J2_NEED_PAGE": "기록 내실의 두 번째 페이지와 수첩의 파형이 필요하다.",
"CH1_J2_MISALIGNED": "진입파가 긴 홈과 어긋난다. 반사파의 두 갈래와 마지막 문단을 함께 비교한다.",
"CH1_J2_BOARD": "페이지: 긴 홈이 위에서 시작 → 두 문장으로 갈라짐 → 바깥 문단을 감쌈\n투명지 시작점: ",
"CH1_J2_ROTATE": "투명지 90° 회전",
"CH1_J2_COMPARE": "세 눌림 구간 대조",
"CH1_J2_RESTORED": "열세 번째 소리는 문을 여는 열쇠가 아니다.\n한동안 굳어 있던 표면을 잠시 느슨하게 만드는 신호다.\n\n긴 떨림이 길을 만들고, 두 번의 짧은 반사가 갈라진 자리를 찾으며, 마지막 잔향이 바깥을 닫는다.\n\n그때 검은 표면을 지워라. 너무 강한 것은 얼룩뿐 아니라, 그 아래의 길까지 없앤다.\n부드러운 천을 쓰고, 서로를 삼키지 않는 세 재료를 먼저 확인해라.",
"CH1_CLOCK_TEST_OK": "대시계까지 약한 진동이 도달한다. 이 시험으로 전달 시점은 확인할 수 없다.",
"CH1_CLOCK_ACTIVATION_OK": "대응접실의 열두 번이 끝난다. 외부 서고 벽을 지난 진동이 한 칸 늦게 도착하고, 서쪽 공명통에서 열세 번째 금속음이 울린다.",
"CH1_CLOCK_RESULT_REFERENCE": "시작 진동이 만들어지지 않는다. 기준 시계의 진동선을 다시 확인한다.",
"CH1_CLOCK_FAILURE_REFERENCE_NOTE": "시작 진동이 만들어지지 않는다. 기준 시계의 진동선을 다시 확인한다.\n봉인핀이 꺾였다. 오늘 다시 움직일 수 없다. 잠들면 핀은 돌아오고, 확인한 결과는 수첩에 남는다.",
"CH1_CLOCK_FAILURE_REFERENCE": "시작 진동이 만들어지지 않는다. 기준 시계의 진동선을 다시 확인한다.\n봉인핀이 꺾였다. 오늘 다시 움직일 수 없다. 잠들면 핀은 돌아오고, 확인한 결과는 수첩에 남는다.\n에드가: 같은 소리가 다시 나지 않도록 점검할 의무가 있습니다. 원인을 기록하셨다면, 점검 순서를 확인하겠습니다.",
"CH1_CLOCK_RESULT_RELAY": "벽 중간에서 진동이 끊긴다. 바늘의 움직임과 신호 전달은 같은 기능이 아니다.",
"CH1_CLOCK_FAILURE_RELAY_NOTE": "벽 중간에서 진동이 끊긴다. 바늘의 움직임과 신호 전달은 같은 기능이 아니다.\n봉인핀이 꺾였다. 오늘 다시 움직일 수 없다. 잠들면 핀은 돌아오고, 확인한 결과는 수첩에 남는다.",
"CH1_CLOCK_FAILURE_RELAY": "벽 중간에서 진동이 끊긴다. 바늘의 움직임과 신호 전달은 같은 기능이 아니다.\n봉인핀이 꺾였다. 오늘 다시 움직일 수 없다. 잠들면 핀은 돌아오고, 확인한 결과는 수첩에 남는다.\n에드가: 같은 소리가 다시 나지 않도록 점검할 의무가 있습니다. 원인을 기록하셨다면, 점검 순서를 확인하겠습니다.",
"CH1_CLOCK_RESULT_OUTPUT": "공명통 대신 종이 울린다. 신호를 만드는 곳과 받아 울리는 곳을 구별한다.",
"CH1_CLOCK_FAILURE_OUTPUT_NOTE": "공명통 대신 종이 울린다. 신호를 만드는 곳과 받아 울리는 곳을 구별한다.\n봉인핀이 꺾였다. 오늘 다시 움직일 수 없다. 잠들면 핀은 돌아오고, 확인한 결과는 수첩에 남는다.",
"CH1_CLOCK_FAILURE_OUTPUT": "공명통 대신 종이 울린다. 신호를 만드는 곳과 받아 울리는 곳을 구별한다.\n봉인핀이 꺾였다. 오늘 다시 움직일 수 없다. 잠들면 핀은 돌아오고, 확인한 결과는 수첩에 남는다.\n에드가: 같은 소리가 다시 나지 않도록 점검할 의무가 있습니다. 원인을 기록하셨다면, 점검 순서를 확인하겠습니다.",
"CH1_CLOCK_RESULT_EXCLUDED": "연결하지 않아야 할 선이 시계망에 들어가 있다.",
"CH1_CLOCK_FAILURE_EXCLUDED_NOTE": "연결하지 않아야 할 선이 시계망에 들어가 있다.\n봉인핀이 꺾였다. 오늘 다시 움직일 수 없다. 잠들면 핀은 돌아오고, 확인한 결과는 수첩에 남는다.",
"CH1_CLOCK_FAILURE_EXCLUDED": "연결하지 않아야 할 선이 시계망에 들어가 있다.\n봉인핀이 꺾였다. 오늘 다시 움직일 수 없다. 잠들면 핀은 돌아오고, 확인한 결과는 수첩에 남는다.\n에드가: 같은 소리가 다시 나지 않도록 점검할 의무가 있습니다. 원인을 기록하셨다면, 점검 순서를 확인하겠습니다.",
"CH1_CLOCK_RESULT_PHASE_TOO_EARLY": "너무 이른 금속음. 정상 종이 끝나기 전에 전달이 시작됐다.",
"CH1_CLOCK_FAILURE_PHASE_TOO_EARLY_NOTE": "너무 이른 금속음. 정상 종이 끝나기 전에 전달이 시작됐다.\n봉인핀이 꺾였다. 오늘 다시 움직일 수 없다. 잠들면 핀은 돌아오고, 확인한 결과는 수첩에 남는다.",
"CH1_CLOCK_FAILURE_PHASE_TOO_EARLY": "너무 이른 금속음. 정상 종이 끝나기 전에 전달이 시작됐다.\n봉인핀이 꺾였다. 오늘 다시 움직일 수 없다. 잠들면 핀은 돌아오고, 확인한 결과는 수첩에 남는다.\n에드가: 같은 소리가 다시 나지 않도록 점검할 의무가 있습니다. 원인을 기록하셨다면, 점검 순서를 확인하겠습니다.",
"CH1_CLOCK_RESULT_PHASE_SIMULTANEOUS": "열두 번째 종과 겹쳤다. 끝난 뒤의 빈 칸은 울리지 않았다.",
"CH1_CLOCK_FAILURE_PHASE_SIMULTANEOUS_NOTE": "열두 번째 종과 겹쳤다. 끝난 뒤의 빈 칸은 울리지 않았다.\n봉인핀이 꺾였다. 오늘 다시 움직일 수 없다. 잠들면 핀은 돌아오고, 확인한 결과는 수첩에 남는다.",
"CH1_CLOCK_FAILURE_PHASE_SIMULTANEOUS": "열두 번째 종과 겹쳤다. 끝난 뒤의 빈 칸은 울리지 않았다.\n봉인핀이 꺾였다. 오늘 다시 움직일 수 없다. 잠들면 핀은 돌아오고, 확인한 결과는 수첩에 남는다.\n에드가: 같은 소리가 다시 나지 않도록 점검할 의무가 있습니다. 원인을 기록하셨다면, 점검 순서를 확인하겠습니다.",
"CH1_CLOCK_RESULT_PHASE_BETWEEN": "종 사이로 불완전한 진동이 새어 나왔다.",
"CH1_CLOCK_FAILURE_PHASE_BETWEEN_NOTE": "종 사이로 불완전한 진동이 새어 나왔다.\n봉인핀이 꺾였다. 오늘 다시 움직일 수 없다. 잠들면 핀은 돌아오고, 확인한 결과는 수첩에 남는다.",
"CH1_CLOCK_FAILURE_PHASE_BETWEEN": "종 사이로 불완전한 진동이 새어 나왔다.\n봉인핀이 꺾였다. 오늘 다시 움직일 수 없다. 잠들면 핀은 돌아오고, 확인한 결과는 수첩에 남는다.\n에드가: 같은 소리가 다시 나지 않도록 점검할 의무가 있습니다. 원인을 기록하셨다면, 점검 순서를 확인하겠습니다.",
"CH1_CLOCK_RESULT_PHASE_UNSET": "전달 시점을 설정하지 않았다.",
"CH1_CLOCK_FAILURE_PHASE_UNSET_NOTE": "전달 시점을 설정하지 않았다.\n봉인핀이 꺾였다. 오늘 다시 움직일 수 없다. 잠들면 핀은 돌아오고, 확인한 결과는 수첩에 남는다.",
"CH1_CLOCK_FAILURE_PHASE_UNSET": "전달 시점을 설정하지 않았다.\n봉인핀이 꺾였다. 오늘 다시 움직일 수 없다. 잠들면 핀은 돌아오고, 확인한 결과는 수첩에 남는다.\n에드가: 같은 소리가 다시 나지 않도록 점검할 의무가 있습니다. 원인을 기록하셨다면, 점검 순서를 확인하겠습니다.",
"CH1_CLOCK_BEDROOM": "선들은 종이 가장자리에 닿기 전에 모두 끊긴다. 이 시계는 느리지만, 더 큰 시계망에는 연결되지 않았다.",
"CH1_CLOCK_PARLOR": "가운데 선이 다른 시계보다 굵다. 진동은 이곳에서 바깥으로 퍼진다. 열두 번이 끝난 뒤에도 배선에 짧은 떨림이 남는다.",
"CH1_CLOCK_LIBRARY_OUTER": "바늘은 멈췄는데 벽 안의 진동은 지나간다. 흑연이 종이 뒷면까지 번졌다. 앞면의 선은 동쪽으로 향한다.",
"CH1_CLOCK_GREAT_CLOCK": "종 대신 빈 공명통으로 선이 모인다. XII 뒤 이름 없는 홈이 한 칸 더 있다. 점검 쪽지에는 '본 종이 끝난 뒤 점검'이라고 적혀 있다.",
"CH1_CLOCK_RUB": "시계 배선 조사 · 탁본 뜨기",
"CH1_CLOCK_NEED_J1": "일지의 첫 페이지를 복원한 뒤 각 방의 시계에서 탁본을 뜬다.",
"CH1_CLOCK_LOCKED": "봉인핀 파손 · 오늘 시계망 잠김\n잠들면 핀은 원래대로 돌아온다. 수첩의 실패 기록은 남는다.",
"CH1_CLOCK_COLLECT": "당일 탁본: %d / 4\n침실 · 대응접실 · 외부 서고 · 서쪽 대시계\n각 방에서 시계를 직접 조사한다.",
"CH1_CLOCK_LAYOUT": "탁본 조립: 위쪽 모서리 홈을 맞춘 뒤 [시작 → 통과 → 공명통]으로 연결한다. 단절된 조각은 네 번째 칸.\n조각을 눌러 두 자리를 교환한다. 나사·문양과 방 이름은 색 없이도 읽을 수 있다.",
"CH1_CLOCK_CARD": "%d번 자리 · %s\n모서리 홈: %s\n%s\n%s",
"CH1_CLOCK_ROTATE": "90° 회전",
"CH1_CLOCK_FLIP": "외부 서고 탁본 뒤집기",
"CH1_CLOCK_CHECK": "약한 진동으로 배선 추적",
"CH1_CLOCK_SWAP": "%d번 조각 선택 · 교환할 다른 자리를 누른다.",
"CH1_CLOCK_ROLES": "배치와 역할은 별도 설정이다. 약한 시험은 배선만 확인하며 전달 시점은 확인하지 않는다.",
"CH1_CLOCK_SELECT": "시계 선택",
"CH1_CLOCK_SELECTED": " · 선택",
"CH1_CLOCK_TEST": "약한 시험 진동",
"CH1_CLOCK_ACTIVATE": "저녁 시계망 실제 작동",
"CH1_CLOCK_CONFIRM": "봉인핀 확인",
"CH1_CLOCK_WARNING": "오류가 있으면 봉인핀이 꺾여 오늘 다시 시도할 수 없다. 잠든 뒤 같은 아침에서 다시 준비한다.",
"CH1_CLOCK_RETEST": "약한 시험 진동을 다시 보낸다",
"CH1_CLOCK_COMMIT": "현재 설정으로 작동한다",
"CH1_CLOCK_EDIT": "설정을 고친다",
"CH1_CLOCK_FRONT": "앞면",
"CH1_CLOCK_BACK": "뒷면",
"CH1_CLOCK_NAME_BEDROOM": "침실",
"CH1_CLOCK_NAME_PARLOR": "대응접실",
"CH1_CLOCK_NAME_LIBRARY_OUTER": "외부 서고",
"CH1_CLOCK_NAME_GREAT_CLOCK": "서쪽 대시계",
"CH1_CLOCK_ROLE_REFERENCE": "기준",
"CH1_CLOCK_ROLE_RELAY": "중계",
"CH1_CLOCK_ROLE_OUTPUT": "출력",
"CH1_CLOCK_ROLE_EXCLUDED": "제외",
"CH1_CLOCK_PHASE_0": "-1 · 마지막 종 전",
"CH1_CLOCK_PHASE_1": "0 · 열두 번째 종과 동시",
"CH1_CLOCK_PHASE_2": "+1 · 정상 종 뒤 한 칸",
"CH1_CLOCK_PHASE_3": "HALF · 종 사이",
"CH1_CLOCK_PATTERN_BEDROOM": "중앙에서 끊긴 선",
"CH1_CLOCK_PATTERN_PARLOR": "굵은 시작선 →",
"CH1_CLOCK_PATTERN_LIBRARY_OUTER": "중계선 →",
"CH1_CLOCK_PATTERN_LIBRARY_BACK": "← 중계선",
"CH1_CLOCK_PATTERN_GREAT_CLOCK": "선 → 빈 공명통",
"CH1_CLOCK_DIR_0": "위 ↑",
"CH1_CLOCK_DIR_90": "오른쪽 →",
"CH1_CLOCK_DIR_180": "아래 ↓",
"CH1_CLOCK_DIR_270": "왼쪽 ←",
"CH1_INNER_PRESSURE": "발소리가 가까워졌다. 숨을지, 남아서 말을 걸지 정한다.",
"CH1_INNER_UNKNOWN": "알 수 없는 조사 대상이다.",
"CH1_INNER_DESK": "손상된 일지와 압지 세 장. 모서리 홈과 눌림선을 맞추면 읽을 수 있을 것 같다.",
"CH1_INNER_DESK_VISIT": "손상된 일지와 압지 세 장. 모서리 홈과 눌림선을 맞추면 읽을 수 있을 것 같다.\n문밖에서 발소리가 멎는다. 잠금쇠가 돌아간다.",
"CH1_INNER_INDEX": "색인 카드를 넘기는 소리가 문 쪽으로 선명하게 번진다.",
"CH1_INNER_INDEX_VISIT": "색인 카드를 넘기는 소리가 문 쪽으로 선명하게 번진다.\n문밖에서 발소리가 멎는다. 잠금쇠가 돌아간다.",
"CH1_INNER_DRAWER": "서랍이 걸리며 나무가 짧게 운다.",
"CH1_INNER_DRAWER_VISIT": "서랍이 걸리며 나무가 짧게 운다.\n문밖에서 발소리가 멎는다. 잠금쇠가 돌아간다.",
"CH1_INNER_ALCOVE": "점검 벽감의 안쪽이 비어 있다. 몸을 숨길 수 있다.",
"CH1_INNER_ALCOVE_VISIT": "점검 벽감의 안쪽이 비어 있다. 몸을 숨길 수 있다.\n문밖에서 발소리가 멎는다. 잠금쇠가 돌아간다.",
"CH1_INNER_GAP": "마침표 뒤 한 칸의 빈 공간, 그 다음에 잉크점. 끝난 뒤에도 남아 있는 소리.",
"CH1_INNER_GAP_VISIT": "마침표 뒤 한 칸의 빈 공간, 그 다음에 잉크점. 끝난 뒤에도 남아 있는 소리.\n문밖에서 발소리가 멎는다. 잠금쇠가 돌아간다.",
"CH1_INNER_LINK": "초상화 패널의 안쪽 걸쇠다. 복원된 일지와 경로를 확인해야 열 수 있다.",
"CH1_INNER_LINK_VISIT": "초상화 패널의 안쪽 걸쇠다. 복원된 일지와 경로를 확인해야 열 수 있다.\n문밖에서 발소리가 멎는다. 잠금쇠가 돌아간다.",
"CH1_INNER_LINK_OPEN": "안쪽 걸쇠를 열었다. 다음 아침에는 이 구조를 기억해 연결문을 빠르게 열 수 있다.",
"CH1_INNER_LINK_OPEN_VISIT": "안쪽 걸쇠를 열었다. 다음 아침에는 이 구조를 기억해 연결문을 빠르게 열 수 있다.\n문밖에서 발소리가 멎는다. 잠금쇠가 돌아간다.",
"CH1_INNER_LABEL_DESK": "일지 책상",
"CH1_INNER_LABEL_INDEX": "색인함",
"CH1_INNER_LABEL_DRAWER": "작은 서랍",
"CH1_INNER_LABEL_ALCOVE": "점검 벽감 · 숨을 공간",
"CH1_INNER_LABEL_GAP": "일지의 마지막 여백",
"CH1_INNER_LABEL_LINK": "초상화 뒤 연결문 걸쇠",
"CH1_J1_FRAGMENT_0": "네가 어제를 기억한다면,\n얼굴이 가리키는 시각부터 믿지는 마라.",
"CH1_J1_FRAGMENT_1": "하나는 하루를 세고,\n하나는 멈춘 채 떨림을 다음 방으로 넘기며,\n하나는 목소리를 잃은 채 마지막 문을 울린다.",
"CH1_J1_FRAGMENT_2": "틀린 것은 시간이 아니다.\n모두 끝났다고 믿은 뒤에도, 한 칸 남아 있는 소리다. ·",
"CH1_J1_RESTORED": "네가 어제를 기억한다면,\n얼굴이 가리키는 시각부터 믿지는 마라.\n\n하나는 하루를 세고,\n하나는 멈춘 채 떨림을 다음 방으로 넘기며,\n하나는 목소리를 잃은 채 마지막 문을 울린다.\n\n틀린 것은 시간이 아니다.\n모두 끝났다고 믿은 뒤에도, 한 칸 남아 있는 소리다. ·",
"CH1_J1_FRONT": "앞면 · 홈이 읽힘",
"CH1_J1_BACK": "뒷면 · 번진 잉크",
"CH1_J1_FLIP": "앞뒤 뒤집기",
"CH1_J1_ORDER": "선택한 순서: ",
"CH1_J1_CLEAR": "배열 다시 놓기",
"CH1_J1_VERIFY": "눌림선과 문장 확인",
"CH1_J1_NEED_DESK": "책상의 압지를 확인하고 조용히 펼칠 자리를 확보한다.",
"CH1_J1_ALREADY": "첫 페이지는 이미 복원되어 있다.",
"CH1_J1_NEED_PIECE": "압지 조각을 선택한다.",
"CH1_J1_WRONG_ORDER": "눌림 자국이 한 줄 어긋난다. 조각은 손상되지 않았다.",
"CH1_J1_WRONG_FACE": "잉크가 손끝에 묻지만 문장은 드러나지 않는다. 압지의 앞뒤를 확인한다.",
"CH1_J1_READ": "복원된 일지 다시 읽기",
"CH1_HISTORY_READ_ERROR": "일부 대화 기록을 읽지 못했습니다. 읽을 수 있는 항목만 표시하며 원본 기록은 변경하지 않습니다.",
"HISTORY_OPTIONS": "표시된 선택지",
"HISTORY_SELECTED": "선택한 문구",
"CH1_HISTORY_TRANSCRIPT": "{speaker}: {text}",
"CH1_HISTORY_TITLE": "대화 기록",
"CH1_HISTORY_EMPTY": "아직 기록된 대사가 없다.",
"CH1_HISTORY_SAVE_ERROR": "대화 기록을 저장하지 못했습니다. 현재 화면의 진행 또는 선택 버튼을 눌러 재시도하십시오.",
"CH1_B2_HIDDEN_BOARD": "점검 벽감 안\n에드가가 책상을 확인하고 있다. 잠시 뒤 발소리가 멀어진다.",
"CH1_B2_ENTRY": "문밖의 발소리가 멎는다. 잠금쇠가 돌아간다.",
"CH1_B2_HIDE": "점검 벽감에 숨는다",
"CH1_B2_TALK": "남아서 에드가에게 말을 건다",
"CH1_B2_HIDDEN": "벽감 안에서 숨을 고른다. 에드가가 들어와 책상과 잠금선을 확인한다.",
"CH1_B2_NORMAL": "보고 싶은 책이 있으십니까? 열람이 끝나면 제자리에 두십시오.",
"CH1_B2_ALERT": "보고 싶은 책이 있으십니까? 열람이 끝나면 제자리에 두십시오.\n우연히 이 시간에 오신 것이라면, 다음에도 같은 우연이 생기지는 않겠습니까.",
"CH1_B2_LEFT": "발소리가 다시 멀어진다. 에드가는 문을 닫고 나갔다. 압지와 일지는 그대로다.",
"CH1_B2_ABSENT": "에드가는 지금 이 방에 없다.",
"CH1_B2_NEED_ALCOVE": "먼저 숨을 수 있는 점검 벽감을 확인한다.",
"CH1_B2_FINISHED": "점검은 이미 끝났다.",
"CH1_B2_WAITING": "에드가가 대답을 기다린다.",
"CH1_B1_DOC_EDGAR": "에드가 업무 장부",
"CH1_B1_DOC_LUCA": "루카 전달표",
"CH1_B1_DOC_MARA1": "마라 1 청소표",
"CH1_B1_DOC_MARA2": "마라 2 기록 반출표 (선택)",
"CH1_B1_READ": " · 읽음",
"CH1_B1_BOARD": "문서의 시간 표현을 연결한다",
"CH1_B1_TITLE": "기록 내실이 비는 구간",
"CH1_B1_PROMPT": "읽은 문서에서 에드가의 위치와 복도 작업의 끝을 비교한다.",
"CH1_B1_MORNING": "아침부터 오후 차 전",
"CH1_B1_TEA": "오후 차 회수 뒤부터 저녁 종 전",
"CH1_B1_BELL": "저녁 종 뒤",
"CH1_B1_NEED_CONFIRM": "수첩의 지속을 확인한 뒤 사용인 공용실에서 조사한다.",
"CH1_B1_NEED_DOCS": "시간 표현을 교차 확인할 핵심 문서가 두 장 이상 필요하다.",
"CH1_B1_WRONG": "그 시간에는 기록 내실 감독 또는 복귀 서명이 남아 있다. 차 회수와 저녁 종 사이를 비교한다.",
"CH1_B1_SOLVED": "오후 차를 치운 뒤, 저녁 종이 울리기 전에는 기록 내실이 비어 있다.",
"CH1_B1_TEXT_EDGAR": "업무 장부. 아침 인사 후 외부 서고 감독. 오후 차 회수 확인. 서쪽 대시계 점검. 저녁 종 뒤 기록 내실 복귀.\n정정: '오후 차 회수 직후부터 저녁 종 직전까지'로 고침.",
"CH1_B1_TEXT_LUCA": "오후 차 회수 뒤: 따뜻한 물 한 주전자, 마른 천 두 장, 손잡이가 작은 잔 하나. 전달 장소: 서쪽 대시계실.\n서명은 대시계 점검대에서 받을 것. 잔이 식기 전에 돌아올 것.",
"CH1_B1_TEXT_MARA1": "서재 복도: 오전 먼지 제거, 오후 차 회수 전 바닥 마감. 차 회수 뒤에는 도구 반납. 저녁 종 전 재진입 없음.\n사다리 바퀴에 기름을 너무 많이 칠했슴다. 정말 잘 굴러가서 제가 잡으러 뛰어갔슴다.",
"CH1_B1_TEXT_MARA2": "초상 기록 반출: 오후 차 직후 완료. 대상 인덱스 다섯. 반환 예정: 저녁 종 뒤.\n중복 아니야! 둘 다 나야!",
"CH1_OBJ_A1": "수첩에 다음 아침과 비교할 표식을 남긴다",
"CH1_OBJ_AS": "익숙한 일과를 마치고 침실에서 잠든다",
"CH1_OBJ_A2": "다음 아침의 수첩 표식을 확인한다",
"CH1_OBJ_B1": "사용인 공용실의 문서 두 장 이상으로 빈 시간대를 추론한다",
"CH1_OBJ_B2": "일과를 마치고 외부 서고를 통해 기록 내실에 접근한다",
"CH1_OBJ_J1": "책상의 압지 조각을 배열해 첫 페이지를 복원한다",
"CH1_OBJ_B3_A": "네 방의 시계 탁본을 모아 배선을 연결한다",
"CH1_OBJ_B3_B": "역할과 전달 시점을 설정해 시계망을 작동한다",
"CH1_OBJ_BF": "남은 조사 후 침실에서 잠든다 · 실패 정보는 남는다",
"CH1_OBJ_B4": "공명통에 남은 파형을 수첩에 기록한다",
"CH1_OBJ_B5": "기록 내실에서 파형과 두 번째 페이지를 겹친다",
"CH1_OBJ_J2_COMPLETE": "첫 장의 기록을 확인한다 · 다음은 검은 거울",
"CH1_OBJ_DEFAULT": "수첩을 확인한다",
"CH1_BED_MARK": "수첩의 빈 페이지에 표식을 남긴다",
"CH1_BED_CONFIRM": "수첩 표식과 방의 흔적을 비교한다",
"CH1_BED_NOTEBOOK": "수첩의 기록",
"CH1_BED_ROUTINE": "익숙한 순서대로 일과를 마친다",
"CH1_BED_ROUTINE_DONE": "익숙한 순서대로 일과를 마친다 · 완료",
"CH1_BED_SLEEP": "침대 · 잠든다",
"CH1_BED_SHORTCUT": "수첩의 검증 정보로 준비를 축약한다",
"CH1_MARK_TITLE": "자기 표식",
"CH1_MARK_PROMPT": "다음 아침의 내가 알아볼 흔적을 남긴다.",
"CH1_MARK_SENTENCE": "내일 아침, 이 문장을 읽어.",
"CH1_MARK_HOUSE_GLYPH": "창문 셋, 뾰족한 지붕, 왼쪽으로 기운 문",
"CH1_MARK_INK_CORNER": "페이지 모서리의 잉크 한 방울",
"CH1_SLEEP_TITLE": "잠들기",
"CH1_SLEEP_RULE": "물건과 장치의 상태는 같은 아침으로 돌아온다. 수첩과 확인한 정보, 사용인의 기억은 남는다."
},
"en-US": {
"CH1_BSHORT_BEDROOM": "Open the notebook in the same bedroom to begin the preparation route.",
"CH1_BSHORT_UNAVAILABLE": "Preparation requires a reset, a verified layout and an unresolved failure record. If the signal has already been produced or recorded, continue investigating that result.",
"CH1_BSHORT_COMPLETE": "I finished the routine from the same bedroom. Following my notes, I took fresh rubbings from all four rooms and restored only the verified wiring and roles. I must set the transmission timing myself.",
"CH1_B4_NEED_SIGNAL": "A signal must remain in the resonance chamber before I can record its waveform.",
"CH1_B4_RECORD": "Record the chamber's three wave segments on a transparent sheet",
"CH1_B4_RECORDED": "I recorded a long, low entry wave, two short branching reflections, and a slow residual wave closing the outside on a transparent sheet.",
"CH1_J2_ALREADY": "The second page has already been restored. Read it again in the notebook.",
"CH1_J2_NEED_PAGE": "I need the second page in the inner archive and the waveform in my notebook.",
"CH1_J2_MISALIGNED": "The entry wave does not align with the long groove. Compare both branches of the reflected wave with the final paragraph.",
"CH1_J2_BOARD": "Page: long groove begins at the top → branches into two sentences → wraps around the outer paragraph\nTransparent sheet starts: ",
"CH1_J2_ROTATE": "Rotate the transparent sheet 90°",
"CH1_J2_COMPARE": "Compare the three impression segments",
"CH1_J2_RESTORED": "The thirteenth sound is not a key that opens a door.\nIt is a signal that briefly loosens a surface hardened for some time.\n\nA long vibration makes a path. Two short reflections find the branching point, and the final resonance closes the outside.\n\nWipe away the black surface then. Something too strong will erase not only the stain, but the path beneath it.\nUse a soft cloth, and first identify three ingredients that do not consume one another.",
"CH1_CLOCK_TEST_OK": "A weak vibration reaches the great clock. This test cannot verify the transmission timing.",
"CH1_CLOCK_ACTIVATION_OK": "The parlor's twelve chimes end. The vibration passes through the outer library wall and arrives one step later. A thirteenth metallic sound rings out from the western resonance chamber.",
"CH1_CLOCK_RESULT_REFERENCE": "No initial vibration is produced. Check the reference clock's vibration line again.",
"CH1_CLOCK_FAILURE_REFERENCE_NOTE": "No initial vibration is produced. Check the reference clock's vibration line again.\nThe sealing pin bent. It cannot move again today. Sleep will restore the pin; the notebook will retain what I learned.",
"CH1_CLOCK_FAILURE_REFERENCE": "No initial vibration is produced. Check the reference clock's vibration line again.\nThe sealing pin bent. It cannot move again today. Sleep will restore the pin; the notebook will retain what I learned.\nEdgar: It is my duty to inspect the mechanism so that this sound does not recur. If you have recorded the cause, I shall check the inspection order.",
"CH1_CLOCK_RESULT_RELAY": "The vibration stops inside the wall. Moving hands and transmitting a signal are not the same function.",
"CH1_CLOCK_FAILURE_RELAY_NOTE": "The vibration stops inside the wall. Moving hands and transmitting a signal are not the same function.\nThe sealing pin bent. It cannot move again today. Sleep will restore the pin; the notebook will retain what I learned.",
"CH1_CLOCK_FAILURE_RELAY": "The vibration stops inside the wall. Moving hands and transmitting a signal are not the same function.\nThe sealing pin bent. It cannot move again today. Sleep will restore the pin; the notebook will retain what I learned.\nEdgar: It is my duty to inspect the mechanism so that this sound does not recur. If you have recorded the cause, I shall check the inspection order.",
"CH1_CLOCK_RESULT_OUTPUT": "A bell rings instead of the resonance chamber. Distinguish the source of a signal from the place that receives and sounds it.",
"CH1_CLOCK_FAILURE_OUTPUT_NOTE": "A bell rings instead of the resonance chamber. Distinguish the source of a signal from the place that receives and sounds it.\nThe sealing pin bent. It cannot move again today. Sleep will restore the pin; the notebook will retain what I learned.",
"CH1_CLOCK_FAILURE_OUTPUT": "A bell rings instead of the resonance chamber. Distinguish the source of a signal from the place that receives and sounds it.\nThe sealing pin bent. It cannot move again today. Sleep will restore the pin; the notebook will retain what I learned.\nEdgar: It is my duty to inspect the mechanism so that this sound does not recur. If you have recorded the cause, I shall check the inspection order.",
"CH1_CLOCK_RESULT_EXCLUDED": "A line that should remain disconnected has been included in the clock network.",
"CH1_CLOCK_FAILURE_EXCLUDED_NOTE": "A line that should remain disconnected has been included in the clock network.\nThe sealing pin bent. It cannot move again today. Sleep will restore the pin; the notebook will retain what I learned.",
"CH1_CLOCK_FAILURE_EXCLUDED": "A line that should remain disconnected has been included in the clock network.\nThe sealing pin bent. It cannot move again today. Sleep will restore the pin; the notebook will retain what I learned.\nEdgar: It is my duty to inspect the mechanism so that this sound does not recur. If you have recorded the cause, I shall check the inspection order.",
"CH1_CLOCK_RESULT_PHASE_TOO_EARLY": "The metallic sound came too early. Transmission began before the normal chimes ended.",
"CH1_CLOCK_FAILURE_PHASE_TOO_EARLY_NOTE": "The metallic sound came too early. Transmission began before the normal chimes ended.\nThe sealing pin bent. It cannot move again today. Sleep will restore the pin; the notebook will retain what I learned.",
"CH1_CLOCK_FAILURE_PHASE_TOO_EARLY": "The metallic sound came too early. Transmission began before the normal chimes ended.\nThe sealing pin bent. It cannot move again today. Sleep will restore the pin; the notebook will retain what I learned.\nEdgar: It is my duty to inspect the mechanism so that this sound does not recur. If you have recorded the cause, I shall check the inspection order.",
"CH1_CLOCK_RESULT_PHASE_SIMULTANEOUS": "It overlapped the twelfth chime. The empty step after the end did not sound.",
"CH1_CLOCK_FAILURE_PHASE_SIMULTANEOUS_NOTE": "It overlapped the twelfth chime. The empty step after the end did not sound.\nThe sealing pin bent. It cannot move again today. Sleep will restore the pin; the notebook will retain what I learned.",
"CH1_CLOCK_FAILURE_PHASE_SIMULTANEOUS": "It overlapped the twelfth chime. The empty step after the end did not sound.\nThe sealing pin bent. It cannot move again today. Sleep will restore the pin; the notebook will retain what I learned.\nEdgar: It is my duty to inspect the mechanism so that this sound does not recur. If you have recorded the cause, I shall check the inspection order.",
"CH1_CLOCK_RESULT_PHASE_BETWEEN": "An incomplete vibration leaked out between the chimes.",
"CH1_CLOCK_FAILURE_PHASE_BETWEEN_NOTE": "An incomplete vibration leaked out between the chimes.\nThe sealing pin bent. It cannot move again today. Sleep will restore the pin; the notebook will retain what I learned.",
"CH1_CLOCK_FAILURE_PHASE_BETWEEN": "An incomplete vibration leaked out between the chimes.\nThe sealing pin bent. It cannot move again today. Sleep will restore the pin; the notebook will retain what I learned.\nEdgar: It is my duty to inspect the mechanism so that this sound does not recur. If you have recorded the cause, I shall check the inspection order.",
"CH1_CLOCK_RESULT_PHASE_UNSET": "The transmission timing has not been set.",
"CH1_CLOCK_FAILURE_PHASE_UNSET_NOTE": "The transmission timing has not been set.\nThe sealing pin bent. It cannot move again today. Sleep will restore the pin; the notebook will retain what I learned.",
"CH1_CLOCK_FAILURE_PHASE_UNSET": "The transmission timing has not been set.\nThe sealing pin bent. It cannot move again today. Sleep will restore the pin; the notebook will retain what I learned.\nEdgar: It is my duty to inspect the mechanism so that this sound does not recur. If you have recorded the cause, I shall check the inspection order.",
"CH1_CLOCK_BEDROOM": "Every line ends before reaching the paper's edge. This clock is slow, but it is not connected to the larger clock network.",
"CH1_CLOCK_PARLOR": "The central line is thicker than on the other clocks. Vibration spreads outward from here. A brief tremor remains in the wiring after all twelve chimes.",
"CH1_CLOCK_LIBRARY_OUTER": "The hands have stopped, but vibration still passes through the wall. Graphite has spread to the back of the paper. The line on the front points east.",
"CH1_CLOCK_GREAT_CLOCK": "The lines converge on an empty resonance chamber instead of a bell. One unnamed groove follows XII. A maintenance note says: 'Inspect after the main chimes end.'",
"CH1_CLOCK_RUB": "Inspect clock wiring · Take a rubbing",
"CH1_CLOCK_NEED_J1": "Restore the first journal page, then take a rubbing from each room's clock.",
"CH1_CLOCK_LOCKED": "Sealing pin broken · Clock network locked today\nSleeping restores the pin. The notebook's failure record remains.",
"CH1_CLOCK_COLLECT": "Today's rubbings: %d / 4\nBedroom · Parlor · Outer library · West great clock\nInspect the clock in each room.",
"CH1_CLOCK_LAYOUT": "Assemble the rubbings: align the upper corner grooves, then connect [start → passage → resonance chamber]. The disconnected piece belongs in the fourth slot.\nSelect two pieces to swap them. Screws, patterns and room names do not rely on color.",
"CH1_CLOCK_CARD": "Slot %d · %s\nCorner groove: %s\n%s\n%s",
"CH1_CLOCK_ROTATE": "Rotate 90°",
"CH1_CLOCK_FLIP": "Turn over the outer-library rubbing",
"CH1_CLOCK_CHECK": "Trace wiring with a weak vibration",
"CH1_CLOCK_SWAP": "Piece %d selected · Select another slot to swap.",
"CH1_CLOCK_ROLES": "Layout and roles are separate settings. The weak test checks wiring, not transmission timing.",
"CH1_CLOCK_SELECT": "Select clock",
"CH1_CLOCK_SELECTED": " · Selected",
"CH1_CLOCK_TEST": "Send a weak test vibration",
"CH1_CLOCK_ACTIVATE": "Activate the evening clock network",
"CH1_CLOCK_CONFIRM": "Check the sealing pin",
"CH1_CLOCK_WARNING": "An error will bend the sealing pin, preventing another attempt today. Sleep, then prepare again from the same morning.",
"CH1_CLOCK_RETEST": "Send another weak test vibration",
"CH1_CLOCK_COMMIT": "Activate with these settings",
"CH1_CLOCK_EDIT": "Adjust the settings",
"CH1_CLOCK_FRONT": "Front",
"CH1_CLOCK_BACK": "Back",
"CH1_CLOCK_NAME_BEDROOM": "Bedroom",
"CH1_CLOCK_NAME_PARLOR": "Parlor",
"CH1_CLOCK_NAME_LIBRARY_OUTER": "Outer library",
"CH1_CLOCK_NAME_GREAT_CLOCK": "West great clock",
"CH1_CLOCK_ROLE_REFERENCE": "Reference",
"CH1_CLOCK_ROLE_RELAY": "Relay",
"CH1_CLOCK_ROLE_OUTPUT": "Output",
