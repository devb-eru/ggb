[gd_resource type="Resource" script_class="LocalizedTextCatalog" load_steps=2 format=3]
[ext_resource type="Script" path="res://scripts/data_types/localized_text_catalog.gd" id="1"]
[resource]
script = ExtResource("1")
localized_text = {
"ko-KR": {
"CH1_B2_HIDDEN_BOARD": "점검 벽감 안\n에드가가 책상을 확인하고 있다. 잠시 뒤 발소리가 멀어진다.",
"CH1_B2_ENTRY": "문밖의 발소리가 멎는다. 잠금쇠가 돌아간다.",
"CH1_B2_HIDE": "점검 벽감에 숨는다",
"CH1_B2_TALK": "남아서 에드가에게 말을 건다",
"CH1_B2_HIDDEN": "벽감 안에서 숨을 고른다. 에드가가 들어와 책상과 잠금선을 확인한다.",
"CH1_B2_NORMAL": "보고 싶은 책이 있으십니까? 열람이 끝나면 제자리에 두십시오.",
"CH1_B2_ALERT": "보고 싶은 책이 있으십니까? 열람이 끝나면 제자리에 두십시오.\n우연히 이 시간에 오신 것이라면, 다음에도 같은 우연이 생기지는 않겠습니까.",
"CH1_B2_LEFT": "발소리가 다시 멀어진다. 에드가는 문을 닫고 나갔다. 압지와 일지는 그대로다.",
"CH1_B2_ABSENT": "에드가는 지금 이 방에 없다.",
"CH1_B2_NEED_ALCOVE": "먼저 숨을 수 있는 점검 벽감을 확인한다.",
"CH1_B2_FINISHED": "점검은 이미 끝났다.",
"CH1_B2_WAITING": "에드가가 대답을 기다린다.",
"CH1_B1_DOC_EDGAR": "에드가 업무 장부",
"CH1_B1_DOC_LUCA": "루카 전달표",
"CH1_B1_DOC_MARA1": "마라 1 청소표",
"CH1_B1_DOC_MARA2": "마라 2 기록 반출표 (선택)",
"CH1_B1_READ": " · 읽음",
"CH1_B1_BOARD": "문서의 시간 표현을 연결한다",
"CH1_B1_TITLE": "기록 내실이 비는 구간",
"CH1_B1_PROMPT": "읽은 문서에서 에드가의 위치와 복도 작업의 끝을 비교한다.",
"CH1_B1_MORNING": "아침부터 오후 차 전",
"CH1_B1_TEA": "오후 차 회수 뒤부터 저녁 종 전",
"CH1_B1_BELL": "저녁 종 뒤",
"CH1_B1_NEED_CONFIRM": "수첩의 지속을 확인한 뒤 사용인 공용실에서 조사한다.",
"CH1_B1_NEED_DOCS": "시간 표현을 교차 확인할 핵심 문서가 두 장 이상 필요하다.",
"CH1_B1_WRONG": "그 시간에는 기록 내실 감독 또는 복귀 서명이 남아 있다. 차 회수와 저녁 종 사이를 비교한다.",
"CH1_B1_SOLVED": "오후 차를 치운 뒤, 저녁 종이 울리기 전에는 기록 내실이 비어 있다.",
"CH1_B1_TEXT_EDGAR": "업무 장부. 아침 인사 후 외부 서고 감독. 오후 차 회수 확인. 서쪽 대시계 점검. 저녁 종 뒤 기록 내실 복귀.\n정정: '오후 차 회수 직후부터 저녁 종 직전까지'로 고침.",
"CH1_B1_TEXT_LUCA": "오후 차 회수 뒤: 따뜻한 물 한 주전자, 마른 천 두 장, 손잡이가 작은 잔 하나. 전달 장소: 서쪽 대시계실.\n서명은 대시계 점검대에서 받을 것. 잔이 식기 전에 돌아올 것.",
"CH1_B1_TEXT_MARA1": "서재 복도: 오전 먼지 제거, 오후 차 회수 전 바닥 마감. 차 회수 뒤에는 도구 반납. 저녁 종 전 재진입 없음.\n사다리 바퀴에 기름을 너무 많이 칠했슴다. 정말 잘 굴러가서 제가 잡으러 뛰어갔슴다.",
"CH1_B1_TEXT_MARA2": "초상 기록 반출: 오후 차 직후 완료. 대상 인덱스 다섯. 반환 예정: 저녁 종 뒤.\n중복 아니야! 둘 다 나야!",
"CH1_OBJ_A1": "수첩에 다음 아침과 비교할 표식을 남긴다",
"CH1_OBJ_AS": "익숙한 일과를 마치고 침실에서 잠든다",
"CH1_OBJ_A2": "다음 아침의 수첩 표식을 확인한다",
"CH1_OBJ_B1": "사용인 공용실의 문서 두 장 이상으로 빈 시간대를 추론한다",
"CH1_OBJ_B2": "일과를 마치고 외부 서고를 통해 기록 내실에 접근한다",
"CH1_OBJ_J1": "책상의 압지 조각을 배열해 첫 페이지를 복원한다",
"CH1_OBJ_B3_A": "네 방의 시계 탁본을 모아 배선을 연결한다",
"CH1_OBJ_B3_B": "역할과 전달 시점을 설정해 시계망을 작동한다",
"CH1_OBJ_BF": "남은 조사 후 침실에서 잠든다 · 실패 정보는 남는다",
"CH1_OBJ_B4": "공명통에 남은 파형을 수첩에 기록한다",
"CH1_OBJ_B5": "기록 내실에서 파형과 두 번째 페이지를 겹친다",
"CH1_OBJ_J2_COMPLETE": "첫 장의 기록을 확인한다 · 다음은 검은 거울",
"CH1_OBJ_DEFAULT": "수첩을 확인한다",
"CH1_BED_MARK": "수첩의 빈 페이지에 표식을 남긴다",
"CH1_BED_CONFIRM": "수첩 표식과 방의 흔적을 비교한다",
"CH1_BED_NOTEBOOK": "수첩의 기록",
"CH1_BED_ROUTINE": "익숙한 순서대로 일과를 마친다",
"CH1_BED_ROUTINE_DONE": "익숙한 순서대로 일과를 마친다 · 완료",
"CH1_BED_SLEEP": "침대 · 잠든다",
"CH1_BED_SHORTCUT": "수첩의 검증 정보로 준비를 축약한다",
"CH1_MARK_TITLE": "자기 표식",
"CH1_MARK_PROMPT": "다음 아침의 내가 알아볼 흔적을 남긴다.",
"CH1_MARK_SENTENCE": "내일 아침, 이 문장을 읽어.",
"CH1_MARK_HOUSE_GLYPH": "창문 셋, 뾰족한 지붕, 왼쪽으로 기운 문",
"CH1_MARK_INK_CORNER": "페이지 모서리의 잉크 한 방울",
"CH1_SLEEP_TITLE": "잠들기",
"CH1_SLEEP_RULE": "물건과 장치의 상태는 같은 아침으로 돌아온다. 수첩과 확인한 정보, 사용인의 기억은 남는다."
},
"en-US": {
"CH1_B2_HIDDEN_BOARD": "Inside the maintenance alcove\nEdgar is checking the desk. Before long, his footsteps recede.",
"CH1_B2_ENTRY": "The footsteps outside the door stop. The latch turns.",
"CH1_B2_HIDE": "Hide in the maintenance alcove",
"CH1_B2_TALK": "Stay and speak to Edgar",
"CH1_B2_HIDDEN": "I steady my breathing in the alcove. Edgar enters and checks the desk and the locking lines.",
"CH1_B2_NORMAL": "Is there a book you wish to read? Please return it to its place when you have finished.",
"CH1_B2_ALERT": "Is there a book you wish to read? Please return it to its place when you have finished.\nIf your arrival at this hour is a coincidence, might the same coincidence occur again?",
"CH1_B2_LEFT": "The footsteps recede again. Edgar has left and closed the door. The blotting paper and journal are untouched.",
"CH1_B2_ABSENT": "Edgar is not in this room right now.",
"CH1_B2_NEED_ALCOVE": "First locate the maintenance alcove where you can hide.",
"CH1_B2_FINISHED": "The inspection is already over.",
"CH1_B2_WAITING": "Edgar is waiting for an answer.",
"CH1_B1_DOC_EDGAR": "Edgar's work ledger",
"CH1_B1_DOC_LUCA": "Luka's delivery sheet",
"CH1_B1_DOC_MARA1": "Mara 1's cleaning schedule",
"CH1_B1_DOC_MARA2": "Mara 2's archive checkout sheet (optional)",
"CH1_B1_READ": " · Read",
"CH1_B1_BOARD": "Compare the time references in the documents",
"CH1_B1_TITLE": "When the inner archive is empty",
"CH1_B1_PROMPT": "Compare Edgar's whereabouts with the end of the corridor work in the documents you have read.",
"CH1_B1_MORNING": "From morning until afternoon tea",
"CH1_B1_TEA": "After tea is cleared away, before the evening bell",
"CH1_B1_BELL": "After the evening bell",
"CH1_B1_NEED_CONFIRM": "Confirm that the notebook persists, then investigate in the servants' common room.",
"CH1_B1_NEED_DOCS": "You need at least two core documents to cross-check the time references.",
"CH1_B1_WRONG": "The records place someone supervising or signing back into the inner archive then. Compare the interval between tea clearance and the evening bell.",
"CH1_B1_SOLVED": "The inner archive is empty after afternoon tea is cleared away and before the evening bell rings.",
"CH1_B1_TEXT_EDGAR": "Work ledger. Supervise the outer library after morning greetings. Confirm afternoon tea clearance. Inspect the west great clock. Return to the inner archive after the evening bell.\nCorrection: amended to 'from immediately after tea clearance until just before the evening bell.'",
"CH1_B1_TEXT_LUCA": "After afternoon tea clearance: one pot of warm water, two dry cloths, one cup with a small handle. Deliver to the west great clock room.\nObtain a signature at the clock inspection bench. Return before the cup cools.",
"CH1_B1_TEXT_MARA1": "Library corridor: dust in the morning; finish the floor before afternoon tea clearance. Return tools after tea clearance. No re-entry before the evening bell.\nPut way too much oil on the ladder wheels. Rolled so well I had to chase it down.",
"CH1_B1_TEXT_MARA2": "Portrait record checkout: completed just after afternoon tea. Five target indices. Due back after the evening bell.\nIt's not a duplicate! They're both me!",
"CH1_OBJ_A1": "Leave a notebook mark to compare the next morning",
"CH1_OBJ_AS": "Finish the familiar routine and sleep in the bedroom",
"CH1_OBJ_A2": "Check the notebook mark the next morning",
"CH1_OBJ_B1": "Compare at least two documents in the servants' common room to find an unoccupied time window",
"CH1_OBJ_B2": "Finish the routine and enter the inner archive through the outer library",
"CH1_OBJ_J1": "Arrange the blotting-paper fragments on the desk to restore the first page",
"CH1_OBJ_B3_A": "Collect clock rubbings from four rooms and connect the wiring",
"CH1_OBJ_B3_B": "Set the roles and transmission timing, then activate the clock network",
"CH1_OBJ_BF": "Finish investigating, then sleep in the bedroom. Information about the failed attempt will remain",
"CH1_OBJ_B4": "Record the waveform left in the resonator in the notebook",
"CH1_OBJ_B5": "Overlay the waveform on the second page in the inner archive",
"CH1_OBJ_J2_COMPLETE": "Review the first chapter's records. Next: the black mirror",
"CH1_OBJ_DEFAULT": "Check the notebook",
"CH1_BED_MARK": "Leave a mark on a blank notebook page",
"CH1_BED_CONFIRM": "Compare the notebook mark with traces in the room",
"CH1_BED_NOTEBOOK": "Notebook entries",
"CH1_BED_ROUTINE": "Finish the routine in the familiar order",
"CH1_BED_ROUTINE_DONE": "Finish the routine in the familiar order · Complete",
"CH1_BED_SLEEP": "Bed · Go to sleep",
"CH1_BED_SHORTCUT": "Use verified notebook information to shorten preparations",
"CH1_MARK_TITLE": "A mark for myself",
"CH1_MARK_PROMPT": "Leave a trace that I will recognize the next morning.",
"CH1_MARK_SENTENCE": "Tomorrow morning, read this sentence.",
"CH1_MARK_HOUSE_GLYPH": "Three windows, a pointed roof, a door leaning left",
"CH1_MARK_INK_CORNER": "A drop of ink at the corner of the page",
"CH1_SLEEP_TITLE": "Go to sleep",
"CH1_SLEEP_RULE": "Objects and devices return to the same morning's state. The notebook, confirmed information, and the servants' memories remain."
}
}
