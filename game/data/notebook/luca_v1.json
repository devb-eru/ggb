		"NB_LUCA_LOG_BLANK": {
			"1": {
				"action_or_variant": "feedback",
				"disclosure_owner": "actual_display",
				"entry_kind": "dialogue",
				"event_id": "E3_3",
				"locales": {
					"en-US": {
						"line_01": "Joint approval criteria after Father's death: Blank. Final release date: Blank. Reason for extension: Awaiting safety confirmation. The same sentence repeats.",
						"speaker": "Protagonist",
						"summary": "Missing Awakening Criteria",
						"title": "Missing Awakening Criteria"
					},
					"ko-KR": {
						"line_01": "아버지 사후 공동 승인 기준: 공란. 최종 해제 날짜: 공란. 연장 사유: 안전 확인 대기. 같은 문장이 반복되어 있다.",
						"speaker": "주인공",
						"summary": "비어 있는 기상 기준",
						"title": "비어 있는 기상 기준"
					}
				},
