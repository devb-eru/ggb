	"contents": {
		"NB_LUCA_CONFESS": {
			"1": {
				"action_or_variant": "feedback",
				"disclosure_owner": "actual_display",
				"entry_kind": "dialogue",
				"event_id": "E3_3",
				"locales": {
					"en-US": {
						"line_01": "I agreed to cryogenic preservation... I believed we could save you. I didn't know you would remain connected this long while the decision kept being delayed.",
						"line_02": "I spoke around the risks because I feared you would leave... Keeping you alive and delaying your decision were not the same thing.",
						"line_03": "Your body outside is alive. I cannot guarantee safety after waking. This time... please choose the order in which you learn the risks.",
						"speaker": "Protagonist",
						"summary": "Luca's Account",
						"title": "Luca's Account"
					},
					"ko-KR": {
						"line_01": "냉각 보존에는 동의했어요... 살릴 수 있다고 믿었어요. 이렇게 오래 접속시키고 결정을 미루게 될 줄은 몰랐어요.",
						"line_02": "위험을 말하면 아가씨가 떠날까 봐... 돌려 말했어요. 살려 둔 것과 결정을 미룬 건 같은 일이 아닌데요.",
						"line_03": "바깥 몸은 살아 있어요. 깨어난 뒤의 안전은 보장할 수 없어요. 이번엔... 어떤 순서로 확인할지 아가씨가 정해 주세요.",
						"speaker": "주인공",
						"summary": "루카의 이야기",
						"title": "루카의 이야기"
					}
				},
				"localization_keys": {
					"line_01": "CONFESS:line_01",
					"line_02": "CONFESS:line_02",
					"line_03": "CONFESS:line_03"
				},
				"location_source": "captured_before_commit_or_actual_display",
				"mapping_status": "AUTHORED_ID",
