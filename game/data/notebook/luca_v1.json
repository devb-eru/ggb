		"NB_LUCA_PANEL": {
			"1": {
				"action_or_variant": "feedback",
				"disclosure_owner": "actual_display",
				"entry_kind": "dialogue",
				"event_id": "E3_3",
				"locales": {
					"en-US": {
						"line_01": "A metallic taste reaches my tongue. The pulse in my wrist and the pipes slips once. The strong paired pulse is BIO MAIN; the dotted response is AUX. The decorative knot has no pulse.",
						"speaker": "Protagonist",
						"summary": "Pulses in My Wrist and the Pipes",
						"title": "Pulses in My Wrist and the Pipes"
					},
					"ko-KR": {
						"line_01": "혀끝에 금속 맛이 돈다. 손목과 배관의 맥박이 한 번 어긋난다. 굵은 이중 맥박은 BIO MAIN, 점선 응답은 AUX다. 장식 매듭에는 맥박이 없다.",
						"speaker": "주인공",
						"summary": "손목과 배관의 맥박",
						"title": "손목과 배관의 맥박"
					}
				},
				"localization_keys": {
					"line_01": "PANEL:line_01"
				},
				"location_source": "captured_before_commit_or_actual_display",
				"mapping_status": "AUTHORED_ID",
