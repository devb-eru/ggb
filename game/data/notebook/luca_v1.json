				"entry_kind": "dialogue",
				"event_id": "E3_3",
				"locales": {
					"en-US": {
						"line_01": "What I called cold earlier wasn't my hand. It was the signal from outside.",
						"speaker": "Protagonist",
						"summary": "What the Cold Signal Meant",
						"title": "What the Cold Signal Meant"
					},
					"ko-KR": {
						"line_01": "아까 차갑다고 한 건 손이 아니라 바깥쪽 신호였어요.",
						"speaker": "주인공",
						"summary": "차갑다는 말의 대상",
						"title": "차갑다는 말의 대상"
					}
				},
