		"NB_LUCA_LOG_PRESERVATION": {
			"1": {
				"action_or_variant": "feedback",
				"disclosure_owner": "actual_display",
				"entry_kind": "dialogue",
				"event_id": "E3_3",
				"locales": {
					"en-US": {
						"line_01": "Cooling purpose: Preserve the body until the toxic atmosphere and radiation risk from the collapse diminish.",
						"speaker": "Protagonist",
						"summary": "The Purpose of Cooling",
						"title": "The Purpose of Cooling"
					},
					"ko-KR": {
						"line_01": "냉각 유지 목적: 멸망기의 독성 대기와 방사선 위험이 낮아질 때까지 신체를 보존한다.",
						"speaker": "주인공",
						"summary": "냉각 유지 목적",
						"title": "냉각 유지 목적"
					}
				},
