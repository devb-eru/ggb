		"NB_LUCA_RECORD": {
			"1": {
				"action_or_variant": "recorded",
				"disclosure_owner": "event_note_commit",
				"entry_kind": "document_segment",
				"event_id": "E3_3",
				"knowledge": {
					"category": "document",
					"epistemic_state": "observed",
					"knowledge_id": "REC_LUCA",
					"lifetime": "persistent",
					"provenance_state": "identified"
				},
				"locales": {
					"en-US": {
						"body": "The Protagonist's external body was cryogenically preserved until the collapse-era toxic atmosphere and radiation risks diminished. Luca agreed to preservation but did not anticipate prolonged confinement in the simulation. After Father's death, neither awakening criteria nor a final release date was established. The servants repeatedly deferred awakening in the name of safety. Vital signs remain stable, but atmospheric, radiation, and neurological risks mean reality cannot be guaranteed safe.",
						"speaker": "Notebook",
						"summary": "Luca's Research Record",
						"title": "Luca's Research Record"
					},
					"ko-KR": {
						"body": "주인공의 외부 신체는 멸망기의 독성 대기·방사선 위험이 낮아질 때까지 냉각 보존되었다. 루카는 보존에 동의했지만 장기 시뮬레이션 감금은 예상하지 못했다. 아버지 사후 기상 기준과 최종 해제 날짜가 확정되지 않았다. 사용인들은 안전을 이유로 각성 결정을 반복 유예했다. 현재 생존 신호는 유지되지만 외부 대기·방사선·신경계 위험이 남아 현실의 안전은 보장할 수 없다.",
						"speaker": "수첩",
						"summary": "루카의 연구 기록",
						"title": "루카의 연구 기록"
					}
				},
				"localization_keys": {
					"body": "RECORD:body"
				},
				"location_source": "captured_before_commit_or_actual_display",
