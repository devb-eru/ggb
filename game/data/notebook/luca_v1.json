		"NB_LUCA_LOG_APPROVAL": {
			"1": {
				"action_or_variant": "feedback",
				"disclosure_owner": "actual_display",
				"entry_kind": "dialogue",
				"event_id": "E3_3",
				"locales": {
					"en-US": {
						"line_01": "Awakening safety decision: Requires joint approval from environmental and operations leads. Stable vital signs and approval to awaken are separate.",
						"speaker": "Protagonist",
						"summary": "Joint Approval for Awakening",
						"title": "Joint Approval for Awakening"
					},
					"ko-KR": {
						"line_01": "기상 안전 판정: 환경 담당과 운영 책임자의 공동 승인 필요. 생존 신호 유지와 기상 안전 승인은 서로 다르다.",
						"speaker": "주인공",
						"summary": "기상 공동 승인",
						"title": "기상 공동 승인"
					}
				},
				"localization_keys": {
