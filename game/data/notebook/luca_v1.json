		"NB_LUCA_MATCH": {
			"1": {
				"action_or_variant": "feedback",
				"disclosure_owner": "actual_display",
				"entry_kind": "dialogue",
				"event_id": "E3_3",
				"locales": {
					"en-US": {
						"line_01": "I compare the current avatar's signal with the external body. Two main pulses, then an auxiliary response, and finally a safety-valve check.",
						"speaker": "Protagonist",
						"summary": "Signals from Avatar and External Body",
						"title": "Signals from Avatar and External Body"
					},
					"ko-KR": {
						"line_01": "현재 아바타와 외부 신체의 신호를 대조한다. 두 번의 주관 맥박 뒤에 보조관 응답, 마지막은 안전 밸브 확인이다.",
						"speaker": "주인공",
						"summary": "아바타와 외부 신체의 신호",
						"title": "아바타와 외부 신체의 신호"
					}
				},
				"localization_keys": {
					"line_01": "MATCH:line_01"
				},
				"location_source": "captured_before_commit_or_actual_display",
