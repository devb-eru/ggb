		"NB_MARA1_CHOOSE_ORIGINAL_ATTRIBUTION": {
			"1": {
				"action_or_variant": "feedback",
				"disclosure_owner": "actual_display",
				"entry_kind": "dialogue",
				"event_id": "E3_1",
				"locales": {
					"en-US": {
						"line_01": "I preserve the commander and operator's responsibility, the victims' record, and the original text unchanged.",
						"speaker": "Protagonist",
						"summary": "Preserving the Record and Responsibility",
						"title": "Preserving the Record and Responsibility"
					},
					"ko-KR": {
						"line_01": "명령자와 수행자의 책임, 피해 기록과 원문을 그대로 남긴다.",
						"speaker": "주인공",
						"summary": "원문과 책임 보존",
						"title": "원문과 책임 보존"
					}
				},
