		"NB_MARA1_CHOOSE_PROTECTED_IDENTIFIERS": {
			"1": {
				"action_or_variant": "feedback",
				"disclosure_owner": "actual_display",
				"entry_kind": "dialogue",
				"event_id": "E3_1",
				"locales": {
					"en-US": {
						"line_01": "I protect only the victims' identifying information. The original incident text and the responsibility of Father as commander and Mara 1 as operator remain.",
						"speaker": "Protagonist",
						"summary": "Protecting Victim Identifiers",
						"title": "Protecting Victim Identifiers"
					},
					"ko-KR": {
						"line_01": "피해자 식별 정보만 보호한다. 사건 원문, 명령자 아버지와 수행자 마라 1의 책임은 남긴다.",
						"speaker": "주인공",
						"summary": "피해자 식별 정보 보호",
						"title": "피해자 식별 정보 보호"
					}
				},
				"localization_keys": {
					"line_01": "CHOOSE_PROTECTED_IDENTIFIERS:line_01"
