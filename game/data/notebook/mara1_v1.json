	"contents": {
		"NB_MARA1_BRIDGE": {
			"1": {
				"action_or_variant": "feedback",
				"disclosure_owner": "actual_display",
				"entry_kind": "dialogue",
				"event_id": "E3_1",
				"locales": {
					"en-US": {
						"line_01": "I remove the false bridge with the spanner. Approval and audit separate from the maintenance record, revealing three fragments.",
						"speaker": "Protagonist",
						"summary": "Removing the False Bridge",
						"title": "Removing the False Bridge"
					},
					"ko-KR": {
						"line_01": "스패너로 가짜 브리지를 해제한다. 승인과 감사가 정비 기록에서 분리되고 세 파편이 드러난다.",
						"speaker": "주인공",
						"summary": "가짜 브리지 해제",
						"title": "가짜 브리지 해제"
					}
				},
				"localization_keys": {
					"line_01": "BRIDGE:line_01"
				},
				"location_source": "captured_before_commit_or_actual_display",
