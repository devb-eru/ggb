		"NB_MARA1_CLEAR": {
			"1": {
				"action_or_variant": "feedback",
				"disclosure_owner": "actual_display",
				"entry_kind": "dialogue",
				"event_id": "E3_1",
				"locales": {
					"en-US": {
						"line_01": "I lay out the fragments again. Identified sources remain recorded.",
						"speaker": "Protagonist",
						"summary": "Fragments Laid Out Again",
						"title": "Fragments Laid Out Again"
					},
					"ko-KR": {
						"line_01": "파편을 다시 펼친다. 이미 조사한 출처는 유지된다.",
						"speaker": "주인공",
						"summary": "다시 펼친 파편",
						"title": "다시 펼친 파편"
					}
				},
				"localization_keys": {
					"line_01": "CLEAR:line_01"
				},
				"location_source": "captured_before_commit_or_actual_display",
