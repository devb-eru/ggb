			}
		},
		"NB_MARA1_RECORD_ORIGINAL_ATTRIBUTION": {
			"1": {
				"action_or_variant": "recorded",
				"disclosure_owner": "event_note_commit",
				"entry_kind": "document_segment",
				"event_id": "E3_1",
				"knowledge": {
					"category": "document",
					"epistemic_state": "observed",
					"knowledge_id": "REC_MARA1",
					"lifetime": "persistent",
					"provenance_state": "identified"
				},
				"locales": {
					"en-US": {
						"body": "I preserve the commander and operator's responsibility, the victims' record, and the original text unchanged.\nThe researchers were promised new bodies but were not told their original bodies would be lost or that they would be converted into neural cores. Under an operational-stability order, Mara 1 erased the failure and contradictions in consent. That work remains in her compulsion to clean.",
						"speaker": "Notebook",
						"summary": "Mara 1's Research Record",
						"title": "Mara 1's Research Record"
					},
					"ko-KR": {
						"body": "명령자와 수행자의 책임, 피해 기록과 원문을 그대로 남긴다.\n연구원들은 새 육체를 약속받았으나 원래 신체 소실과 신경 코어 전환은 고지받지 못했다. 마라 1은 운영 안정화 명령으로 실패와 동의 모순을 지웠다. 그 업무는 지금의 청소 강박으로 남았다.",
						"speaker": "수첩",
						"summary": "마라 1의 연구 기록",
						"title": "마라 1의 연구 기록"
					}
				},
				"localization_keys": {
					"body": "RECORD_ORIGINAL_ATTRIBUTION:body"
				},
				"location_source": "captured_before_commit_or_actual_display",
				"mapping_status": "AUTHORED_ID",
				"node_ids": [
					"E3_1"
				],
				"owner": "planning/engineering",
				"producer_id": "NP10",
