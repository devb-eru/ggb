		"NB_MARA1_PANEL": {
			"1": {
				"action_or_variant": "feedback",
				"disclosure_owner": "actual_display",
				"entry_kind": "dialogue",
				"event_id": "E3_1",
				"locales": {
					"en-US": {
						"line_01": "Dry paper smells from beneath the burned insulation. The diagonal screw line carries brush friction, the palm approval angle two confirmation tones, and the broken square a delayed warning. Approval and audit lines have been merged into maintenance output.",
						"speaker": "Protagonist",
						"summary": "Three Terminal Sources",
						"title": "Three Terminal Sources"
					},
					"ko-KR": {
						"line_01": "탄 피복 아래 마른 종이 냄새가 난다. 대각 나사선은 솔 마찰음, 손바닥 승인각은 두 번 확인음, 끊긴 사각은 늦은 경고음이다. 승인과 감사 선이 정비 출력에 합쳐져 있다.",
						"speaker": "주인공",
						"summary": "세 단자의 출처",
						"title": "세 단자의 출처"
					}
				},
				"localization_keys": {
					"line_01": "PANEL:line_01"
				},
				"location_source": "captured_before_commit_or_actual_display",
				"mapping_status": "AUTHORED_ID",
				"node_ids": [
					"E3_1"
				],
				"owner": "planning/engineering",
				"producer_id": "NP10",
				"protection_reasons": [
					"clue_source"
				],
				"source_file": "scripts/systems/mara1_relationship.gd",
