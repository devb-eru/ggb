		"NB_MARA1_CONFESS": {
			"1": {
				"action_or_variant": "feedback",
				"disclosure_owner": "actual_display",
				"entry_kind": "dialogue",
				"event_id": "E3_1",
				"locales": {
					"en-US": {
						"line_01": "The cleanup went a bit too far...",
						"line_02": "Mara 1's ears and tail go still.",
						"line_03": "I erased it on your father's order. I knew something was wrong, but I wanted to believe it was maintenance that would save the facility. I can't ask you to forgive me. Please decide how this should remain.",
						"speaker": "Protagonist",
						"summary": "Mara 1's Account",
						"title": "Mara 1's Account"
					},
					"ko-KR": {
						"line_01": "청소가 좀 과했슴다...",
						"line_02": "마라 1의 귀와 꼬리가 멎는다.",
						"line_03": "아버님 명령으로 제가 지웠슴다. 이상한 건 알았는데, 시설을 살리는 정비라고 믿고 싶었어요. 용서해 달라는 말은 못 하겠슴다. 이걸 어떻게 남길지, 정해 주십쇼.",
						"speaker": "주인공",
						"summary": "마라 1의 고백",
						"title": "마라 1의 고백"
					}
				},
				"localization_keys": {
					"line_01": "CONFESS:line_01",
					"line_02": "CONFESS:line_02",
					"line_03": "CONFESS:line_03"
				},
				"location_source": "captured_before_commit_or_actual_display",
				"mapping_status": "AUTHORED_ID",
				"node_ids": [
					"E3_1"
				],
				"owner": "planning/engineering",
				"producer_id": "NP10",
				"protection_reasons": [
					"clue_source"
				],
				"source_file": "scripts/systems/mara1_relationship.gd",
