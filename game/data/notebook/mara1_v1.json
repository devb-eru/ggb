		"NB_MARA1_LOG_FAILURE": {
			"1": {
				"action_or_variant": "feedback",
				"disclosure_owner": "actual_display",
				"entry_kind": "dialogue",
				"event_id": "E3_1",
				"locales": {
					"en-US": {
						"line_01": "Day of conversion · References prior approval / Broken square",
						"line_02": "Conversion experiment failure. An undisclosed procedure was executed. The upper wipe connects to the lower edge of the original approval. Heat damage has made some victims' names unreadable.",
						"speaker": "Protagonist",
						"summary": "Failure Report on Conversion Day",
						"title": "Failure Report on Conversion Day"
					},
					"ko-KR": {
						"line_01": "전환 당일 · 앞 승인 원본 참조 / 끊긴 사각",
						"line_02": "전환 실험 실패 발생. 고지되지 않은 절차가 실행됐다. 윗쪽 닦임이 승인 원본의 아랫쪽과 이어진다. 일부 피해자 이름은 열 손상으로 읽히지 않는다.",
						"speaker": "주인공",
						"summary": "전환 당일의 실패 보고",
						"title": "전환 당일의 실패 보고"
					}
				},
				"localization_keys": {
					"line_01": "LOG_FAILURE:line_01",
					"line_02": "LOG_FAILURE:line_02"
				},
				"location_source": "captured_before_commit_or_actual_display",
