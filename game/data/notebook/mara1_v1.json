		"NB_MARA1_LOG_COMMAND": {
			"1": {
				"action_or_variant": "feedback",
				"disclosure_owner": "actual_display",
				"entry_kind": "dialogue",
				"event_id": "E3_1",
				"locales": {
					"en-US": {
						"line_01": "Immediately after failure report · References failure report / Diagonal screw line",
						"line_02": "Father's order: 'Clean up for operational stability.' Operator: Mara 1. The failure log and contradictions in consent procedure were covered by maintenance history.",
						"speaker": "Protagonist",
						"summary": "The Cleanup Order After the Failure",
						"title": "The Cleanup Order After the Failure"
					},
					"ko-KR": {
						"line_01": "실패 보고 직후 · 실패 보고 참조 / 대각 나사선",
						"line_02": "아버지의 명령: '운영 안정성을 위해 정리.' 수행자: 마라 1. 실패 로그와 동의 절차 모순을 정비 이력으로 덮음.",
						"speaker": "주인공",
						"summary": "실패 뒤의 정리 명령",
						"title": "실패 뒤의 정리 명령"
					}
				},
				"localization_keys": {
					"line_01": "LOG_COMMAND:line_01",
					"line_02": "LOG_COMMAND:line_02"
				},
				"location_source": "captured_before_commit_or_actual_display",
