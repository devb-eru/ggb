		"NB_MARA1_LOG_CONSENT": {
			"1": {
				"action_or_variant": "feedback",
				"disclosure_owner": "actual_display",
				"entry_kind": "dialogue",
				"event_id": "E3_1",
				"locales": {
					"en-US": {
						"line_01": "Day before conversion · Original approval / Palm approval angle",
						"line_02": "A promise of life in a new body. The disclosure fields for loss of the original body and conversion into a bio-neural core are blank. A diagonal wipe leading to the next page points downward.",
						"speaker": "Protagonist",
						"summary": "Original Approval Before Conversion",
						"title": "Original Approval Before Conversion"
					},
					"ko-KR": {
						"line_01": "전환 전날 · 승인 원본 / 손바닥 승인각",
						"line_02": "미래에 새 육체로 살아갈 것이라는 약속. 원래 신체 소실과 생체 신경 코어 결합 전환의 고지란은 비어 있다. 다음 장으로 이어지는 대각 닦임이 아래로 향한다.",
						"speaker": "주인공",
						"summary": "전환 전날의 승인 원본",
						"title": "전환 전날의 승인 원본"
					}
				},
				"localization_keys": {
					"line_01": "LOG_CONSENT:line_01",
					"line_02": "LOG_CONSENT:line_02"
				},
				"location_source": "captured_before_commit_or_actual_display",
