					"lifetime": "persistent",
					"provenance_state": "identified"
				},
				"legacy_key": "A1",
				"locales": {
					"en-US": {
						"body": "My mark: Tomorrow morning, read this sentence.\nCheck that it is unchanged the following morning.\nI wrote 'Tomorrow morning,', followed by 'read this sentence.' The detailed shape and depth of the handwriting were not measured separately.",
						"speaker": "Notebook",
						"summary": "The mark experiment",
						"title": "The mark experiment"
					},
					"ko-KR": {
						"body": "자기 표식: 내일 아침, 이 문장을 읽어.\n다음 아침에 동일성을 확인한다.\n'내일 아침,'을 쓰고, '이 문장을', '읽어.'를 이어 썼다. 획과 압흔의 세부 형태는 별도로 측정하지 않았다.",
						"speaker": "수첩",
						"summary": "표식 실험",
						"title": "표식 실험"
					}
