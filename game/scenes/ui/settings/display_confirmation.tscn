[gd_scene format=3]

[ext_resource type="StyleBox" path="res://assets/ui/settings/styles/confirmation_panel.tres" id="paper"]
[ext_resource type="StyleBox" path="res://assets/ui/settings/styles/preview_panel.tres" id="preview"]
[ext_resource type="Script" path="res://scripts/ui/settings_choice.gd" id="choice"]
[ext_resource type="Texture2D" path="res://assets/ui/settings/textures/ink_divider.tres" id="rule"]
[ext_resource type="Theme" path="res://assets/ui/settings/themes/bookmark.tres" id="bookmark"]
[ext_resource type="Theme" path="res://assets/ui/settings/themes/primary.tres" id="primary"]
[ext_resource type="Theme" path="res://assets/ui/settings/themes/keycap.tres" id="keycap"]
[ext_resource type="Theme" path="res://assets/ui/settings/themes/option.tres" id="option"]
[ext_resource type="Font" path="res://assets/ui/settings/themes/settings_font.tres" id="font"]
[sub_resource type="StyleBoxEmpty" id="Empty"]


[node name="Confirmation" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0

[node name="Dimmer" type="ColorRect" parent="."]
layout_mode = 1
anchor_right = 1.0
anchor_bottom = 1.0
color = Color(0.04, 0.03, 0.12, 0.23)

[node name="Center" type="CenterContainer" parent="."]
layout_mode = 1
anchor_top = 0.42
anchor_right = 1.0
anchor_bottom = 1.0

[node name="Paper" type="PanelContainer" parent="Center"]
layout_mode = 2
custom_minimum_size = Vector2(760, 300)
theme_override_styles/panel = ExtResource("paper")

[node name="Margin" type="MarginContainer" parent="Center/Paper"]
layout_mode = 2

[node name="Body" type="VBoxContainer" parent="Center/Paper/Margin"]
layout_mode = 2
theme_override_constants/separation = 16

[node name="Title" type="Label" parent="Center/Paper/Margin/Body"]
layout_mode = 2
mouse_filter = 2
theme_override_fonts/font = ExtResource("font")
theme_override_font_sizes/font_size = 36
text = "이 화면을 유지할까요?"
vertical_alignment = 1
autowrap_mode = 3
metadata/ko = "이 화면을 유지할까요?"
metadata/en = "Keep this display?"
horizontal_alignment = 1
metadata/chrome = true

[node name="Rule" type="TextureRect" parent="Center/Paper/Margin/Body"]
layout_mode = 2
custom_minimum_size = Vector2(0, 8)
mouse_filter = 2
texture = ExtResource("rule")
expand_mode = 1

[node name="Countdown" type="Label" parent="Center/Paper/Margin/Body"]
layout_mode = 2
mouse_filter = 2
theme_override_fonts/font = ExtResource("font")
theme_override_font_sizes/font_size = 28
text = "15초 뒤 이전 설정으로 돌아갑니다."
vertical_alignment = 1
autowrap_mode = 3
metadata/ko = "15초 뒤 이전 설정으로 돌아갑니다."
metadata/en = "Previous settings return in 15 seconds."
horizontal_alignment = 1

[node name="Buttons" type="HBoxContainer" parent="Center/Paper/Margin/Body"]
layout_mode = 2
alignment = 1
theme_override_constants/separation = 24

[node name="Revert" type="Button" parent="Center/Paper/Margin/Body/Buttons"]
layout_mode = 2
custom_minimum_size = Vector2(240, 64)
theme = ExtResource("option")
theme_override_fonts/font = ExtResource("font")
theme_override_styles/focus = SubResource("Empty")
theme_override_font_sizes/font_size = 28
text = "되돌리기"
autowrap_mode = 3
metadata/ko = "되돌리기"
metadata/en = "Revert"
metadata/scale_minimum = true

[node name="Keep" type="Button" parent="Center/Paper/Margin/Body/Buttons"]
layout_mode = 2
custom_minimum_size = Vector2(240, 64)
theme = ExtResource("option")
theme_override_fonts/font = ExtResource("font")
theme_override_styles/focus = SubResource("Empty")
theme_override_font_sizes/font_size = 28
text = "유지"
autowrap_mode = 3
metadata/ko = "유지"
metadata/en = "Keep"
metadata/scale_minimum = true
toggle_mode = true
button_pressed = true
