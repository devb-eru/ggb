[node name="NotebookFilterControls" type="HFlowContainer" parent="NotebookSpread/PageMargin/NotebookContent/NotebookToolsScroll/Tools"]
layout_mode = 2

[node name="NotebookChapterFilter" type="OptionButton" parent="NotebookSpread/PageMargin/NotebookContent/NotebookToolsScroll/Tools/NotebookFilterControls"]
